# Batch 67 — KPERF-017 compression + long-lived asset caching · KSEC-014 security headers / CSP.
gzip on;
gzip_comp_level 5;
gzip_min_length 512;
gzip_vary on;
gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml application/manifest+json;

server {
    listen 10000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # TP007 — lecture videos are uploaded through /api/media/upload.
    client_max_body_size 520m;

    # KSEC-014 — the SPA is same-origin: scripts only from 'self'; https images/frames/media are allowed because
    # library covers, lecture media and the live-class (BigBlueButton) iframe come from configured HTTPS hosts.
    # (If TLS is terminated upstream, also add Strict-Transport-Security there.)
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=()" always;

    location /api/ {
        proxy_pass ${API_UPSTREAM}/api/;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # TRUST_PROXY=1 on the API reads these — needed for per-client rate limits / lockouts (KSEC-005).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;   # KOBS-011 correlation id, echoed back by the API
    }

    # Vite emits content-hashed files under /assets — safe to cache for a year.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # index.html must always be revalidated so a deploy is picked up immediately.
    location = /index.html {
        expires -1;
    }

    location / {
        try_files $uri /index.html;
    }
}
