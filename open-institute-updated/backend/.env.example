DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kvbdtc?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
FRONTEND_ORIGIN="http://localhost:5173"
NODE_ENV=development
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=replace-with-a-unique-password-of-14-characters-or-more

# Digital library — institution-hosted repository connectors (all optional;
# each is only queried if its URL is set). See docs/digital-library-integration.md
DSPACE_BASE_URL=
EPRINTS_OAI_URL=
ISLANDORA_BASE_URL=
GREENSTONE_OAI_URL=

# Digital library — public free APIs, no institutional deployment needed.
# DOAJ, Crossref, arXiv, and Internet Archive work out of the box with NO
# key at all; leave them alone unless you want to turn one off. CORE is the
# one connector here that needs a key — it's still free, just requires a
# personal signup: https://core.ac.uk/services/api
CORE_API_KEY=
# Optional: puts Crossref requests in its faster "polite pool". Not required.
CROSSREF_CONTACT_EMAIL=
# Optional per-source opt-outs (set to "true" to disable; default is enabled):
LIBRARY_DISABLE_DOAJ=
LIBRARY_DISABLE_CROSSREF=
LIBRARY_DISABLE_ARXIV=
LIBRARY_DISABLE_INTERNET_ARCHIVE=

# AI (optional — without this, the AI tutor/adviser/career/simulation
# features return their approved-material summaries directly instead of
# model-phrased responses)
ANTHROPIC_API_KEY=
# AI provider selector (lib/ai-gateway.ts) — optional, defaults to
# "anthropic". Only "anthropic" is actually implemented; this exists as a
# real seam for a second provider later, not a working multi-provider
# switch today. Setting it to anything else makes every AI feature fail
# loudly (governance centre shows it as "unconfigured_provider") instead
# of silently calling Anthropic anyway.
AI_PROVIDER=anthropic

# M-Pesa (Safaricom Daraja) — optional; without these, fee payment STK
# push returns a clear "not configured" message instead of faking success.
# Get these from https://developer.safaricom.co.ke after creating an app.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# Must be a publicly reachable HTTPS URL with the callback token query parameter,
# e.g. https://yourdomain.ac.ke/api/finance/mpesa/callback?token=<random-token>
DARAJA_CALLBACK_URL=
DARAJA_CALLBACK_TOKEN=
# "production" switches both Daraja endpoints from sandbox.safaricom.co.ke
# to api.safaricom.co.ke. Leave unset (or anything else) for sandbox.
DARAJA_ENV=

# Moodle integration (optional — only used for courses where
# Course.lmsEngine = MOODLE; CUSTOM-mode courses ignore all of this)
MOODLE_BASE_URL="http://localhost:8081"
# Web Services token for a dedicated integration service account —
# never a personal admin account. Create via Moodle admin:
# Site administration > Server > Web services > Manage tokens
MOODLE_WS_TOKEN=
# Web Services token for auth_userkey specifically — deliberately
# separate from MOODLE_WS_TOKEN above (least privilege: this token only
# needs the 'auth/userkey:generatekey' capability, nothing else).
# Create via: Admin > Plugins > Web services > Manage tokens, for the
# "User key authentication web service".
MOODLE_SSO_WS_TOKEN=
# Shared secret Moodle event webhooks must present back to us
MOODLE_WEBHOOK_SECRET=
# Moodle category new MOODLE-mode courses are created under (see
# Site administration > Courses > Manage courses and categories for
# the id). Defaults to 1 (Moodle's built-in "Miscellaneous" category).
MOODLE_DEFAULT_CATEGORY_ID=1
# BigBlueButton — direct integration (Batch 50): used for CUSTOM-engine
# courses' live classes (routes/live-classes.ts, lib/bigbluebutton.ts).
# Point this at your BBB server's API and shared secret directly — no
# Moodle required. (Moodle-mode courses still separately read live
# session status back out of Moodle's own bigbluebuttonbn plugin, which
# needs BBB configured inside Moodle itself; that path is unrelated to
# these two variables.)
BBB_SERVER_URL=
BBB_SHARED_SECRET=

# TP007 — where uploaded lesson media (video/audio/images/documents) is stored,
# and the overall per-file ceiling in MB (per-type limits are lower: see
# lib/media-policy.ts). Mount UPLOAD_DIR on a persistent volume.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500
# Admissions uploads use local storage when these are unset. For production,
# create a private Supabase Storage bucket and set all three values on the
# backend only. Never expose the service-role key to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=admission-documents
# LMS037 — "true" (default): a trainer's edit to a PUBLISHED lesson waits for QA
# approval while students keep seeing the last approved version. "false": edits go live at once.
CONTENT_REVIEW_REQUIRED=true
# Time zone used to decide which calendar day a live class belongs to for attendance.
INSTITUTION_TZ=Africa/Nairobi

# --- Virtual Business Lab integration (Batch 65) — see docs/VBL_MAIN_PORTAL_DEPLOYMENT.md ---
VBL_INTEGRATION_URL=http://localhost:8000
VBL_PUBLIC_URL=http://localhost:8000
# Same value must be configured on the Lab. Prefer DB-issued credentials (POST /api/integration/v1/credentials)
# and treat these two as bootstrap fallbacks only.
PORTAL_SSO_SECRET=change-me
PORTAL_WEBHOOK_SECRET=change-me   # signs portal -> Lab events
VBL_WEBHOOK_SECRET=change-me      # verifies Lab -> portal events

# --- Batch 66 ---
# Encrypts integration signing secrets at rest (AES-256-GCM). REQUIRED when NODE_ENV=production.
# Generate with: openssl rand -hex 32   (keep it OUTSIDE the database/backups; losing it invalidates
# every issued credential). Encrypt pre-existing rows once with scripts/encrypt-integration-secrets.ts.
INTEGRATION_SECRET_ENCRYPTION_KEY=
# Background outbox/gradebook sweep. Defaults to on whenever VBL_INTEGRATION_URL is set.
# Safe with several instances: a Postgres advisory lock lets exactly one run each tick.
INTEGRATION_SCHEDULER_ENABLED=true
INTEGRATION_SCHEDULER_INTERVAL_SECONDS=30
# Number of reverse-proxy hops in front of the API (1 for a single nginx). REQUIRED behind a proxy,
# otherwise the shared rate limiter sees every caller as the proxy's IP. Leave unset with no proxy.
TRUST_PROXY=
# Also new: in production the server refuses to start unless JWT_SECRET is a real random value.

# --- Batch 67: security, resilience & observability (all optional; defaults shown) ---
# FRONTEND_ORIGIN accepts several origins, comma-separated (KSEC-013).
# Production boot fails unless JWT_SECRET is >= 32 random chars and FRONTEND_ORIGIN is set (KSEC-002).
SESSION_TTL_MINUTES=720
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_FAILURES=30
PASSWORD_MIN_LENGTH=10
BCRYPT_ROUNDS=12
DB_POOL_SIZE=
DB_POOL_TIMEOUT_S=
AI_MAX_CONCURRENCY=8
AI_MAX_QUEUE=50
AI_TIMEOUT_MS=60000
AI_DAILY_LIMIT_STUDENT=100
AI_DAILY_LIMIT_DEFAULT=300
AI_COST_PER_1K_INPUT_TOKENS=
AI_COST_PER_1K_OUTPUT_TOKENS=
OUTBOUND_ALLOW_HOSTS=
METRICS_TOKEN=
LOG_LEVEL=info
LOG_FORMAT=
