// LMS022 — SCORM support. One package per Lesson (contentType = "scorm").
// The uploaded zip is stored like any other MediaAsset-style upload (see
// lib/media-storage.ts) and additionally extracted to its own directory so
// its internal relative asset references (images/js/css inside the package)
// resolve correctly when launched in an iframe. This is SCORM 1.2 (the
// widely-deployed subset: LMSInitialize/GetValue/SetValue/Commit/Finish
// against the cmi.core.* data model) — not full SCORM 2004 sequencing.
model ScormPackage {
  id              String   @id @default(cuid())
  lessonId        String   @unique
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  zipStorageKey   String   // the original uploaded .zip, kept for re-extraction/audit
  extractKey      String   @unique // directory name under UPLOAD_DIR/scorm/<extractKey>/
  launchUrl       String   // path of the launch file, relative to the extracted directory
  manifestTitle   String?
  scormVersion    String   @default("1.2")
  uploadedById    String
  createdAt       DateTime @default(now())

  attempts ScormAttempt[]
}

// One row per student per package — the live cmi.core.* state a SCORM
// player reads on LMSInitialize and writes on LMSCommit/LMSFinish.
model ScormAttempt {
  id            String       @id @default(cuid())
  packageId     String
  package       ScormPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonStatus  String       @default("not attempted") // passed|completed|failed|incomplete|browsed|not attempted
  scoreRaw      Float?
  scoreMin      Float?
  scoreMax      Float?
  lessonLocation String?
  suspendData   String?      @db.Text
  sessionTimeSeconds Int     @default(0)
  totalTimeSeconds   Int     @default(0)
  startedAt     DateTime     @default(now())
  lastCommittedAt DateTime   @updatedAt

  @@unique([packageId, studentId])
  @@index([studentId])
}

// LMS023 — xAPI (Tin Can) support: a minimal, real Learning Record Store.
// Statements are accepted in the standard actor/verb/object shape and kept
// verbatim (raw) alongside indexed fields for querying. This is a genuine
// statement store, not a full xAPI-conformant LRS (no /statements query
// language, no attachments) — honest scope note, consistent with how this
// codebase documents every other simplified-but-real feature.
model XapiStatement {
  id          String   @id @default(cuid())
  actorUserId String
  verb        String   // e.g. "experienced", "completed", "answered", "attempted"
  objectId    String   // an IRI-like identifier — here, usually "lesson:<id>" or "scorm:<packageId>"
  objectName  String?
  result      Json?    // { completion?, success?, score?: { raw, min, max, scaled } }
  context     Json?
  raw         Json     // the full statement exactly as submitted
  recordedAt  DateTime @default(now())

  @@index([actorUserId])
  @@index([objectId])
}

// LMS029 — time-on-task: real per-lesson time samples, sent by a heartbeat
// from the lesson viewer (see routes/learning-analytics.ts) rather than
// inferred from login/logout gaps. Rolled up in LMS028's analytics.
model LessonTimeLog {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  seconds    Int      // duration of this one sample (heartbeat interval, capped server-side)
  loggedAt   DateTime @default(now())

  @@index([studentId])
  @@index([lessonId])
}

// ---------------------------------------------------------------------------
// AI008–012 (Batch 63) — the real RAG infrastructure stack: ingestion,
// PDF text extraction, chunking, embeddings, and vector search. Every stage
// genuinely runs end-to-end with zero external credentials — see
// lib/pdf-extract.ts, lib/chunking.ts, lib/embeddings.ts,
// lib/vector-search.ts, lib/document-ingestion.ts, and the AI007–012 rows
// in docs/feature-audit-400.md for exactly what each stage does and does
// not do. Default embedding provider is a deterministic local sparse
// vector (real, working lexical retrieval today); a real dense-embedding
// provider (AI011's "openai" branch) is a documented, code-complete
// upgrade path gated on a credential this environment doesn't have, not a
// requirement for this to function.
// ---------------------------------------------------------------------------

// AI008 — one ingested source document (a PDF a trainer uploaded, or pasted
// text/markdown). Keeps the full extracted text so it can be re-chunked
// later (e.g. after a chunking-parameter change) without re-running
// extraction. `unitId` is optional — a source can be ingested generally
// before anyone assigns it to a specific unit.
model KnowledgeSource {
  id                String   @id @default(cuid())
  unitId            String?
  unit              Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  title             String
  sourceType        String   // "pdf" | "text" | "markdown"
  originalUrl       String?  // Document.fileUrl or a media-storage key this was ingested from, if any
  rawText           String   @db.Text
  status            String   @default("pending") // pending | ingested | failed
  errorMessage      String?
  charCount         Int      @default(0)
  chunkCount        Int      @default(0)
  embeddingProvider String   @default("local-tfidf")
  embeddingDims     Int      @default(0)
  uploadedById      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  chunks            DocumentChunk[]

  @@index([unitId])
  @@index([status])
}

// AI010/011 — one chunk of a KnowledgeSource plus its vector. The vector is
// stored as a JSON number array rather than a native `vector` column —
// this environment has no pgvector extension available to confirm a
// migration against (same "unverified until first real boot" caveat every
// schema-touching batch carries). See lib/vector-search.ts for the honest
// note on why a linear cosine-similarity scan over this table is the
// right call at this institution's real document volume, and what a real
// ANN index would buy if that volume ever changes.
model DocumentChunk {
  id         String   @id @default(cuid())
  sourceId   String
  source     KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ordinal    Int
  text       String   @db.Text
  charCount  Int
  vector     Json
  vectorDims Int
  createdAt  DateTime @default(now())

  @@index([sourceId])
}

// AI011 — embedding provider selection, same admin-editable/audited
// singleton-row pattern AI002's AiModelConfig established. Switching
// provider does not retroactively re-embed existing chunks (see
// lib/document-ingestion.ts's reindexSource()) — it only changes what new
// ingestions use, until an explicit reindex is run.
model EmbeddingConfig {
  id          String   @id @default("default")
  provider    String   @default("local-tfidf") // "local-tfidf" | "openai"
  modelId     String?  // e.g. "text-embedding-3-small", only meaningful for provider = "openai"
  notes       String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// LMS019 — completion rules: a trainer-configured threshold for what
// "completed this course" means, read by GET /content/courses/:id/completion
// (per-student) instead of that being an undefined, always-false concept.
model CourseCompletionRule {
  id                      String   @id @default(cuid())
  courseId                String   @unique
  course                  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  minLessonPercent        Int      @default(100) // % of published lessons that must be marked complete
  requirePassingAssessments Boolean @default(true) // every non-draft Assessment's best submission must be >= its passMarkPercent (or the unit's default pass mark if unset)
  updatedById             String
  updatedAt               DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// BATCH 64 — AI033 (AI viva), FN006 (card payment gateway), AI014 (course
// delivery/pacing plan), EX014 (candidate admit cards). See
// docs/progress-batch64.md for the full honest scope of each.
// ---------------------------------------------------------------------------

// AI033 — AI viva. Unlike EX035's OralAssessmentSession (a human-conducted
// exam), this is a real, working AI-conducted oral practice/assessment
// session: the browser's own Web Speech API (already real since AI034/035,
// zero new infrastructure) captures the student's spoken answer as text,
// the existing text AI gateway (callAiModel) generates the examiner's next
// question grounded in the unit's real curriculum topics, and the browser
// reads that question aloud again via speechSynthesis. Every turn is
// persisted, same shape as EX036's SimulationSession/SimulationTurn. The
// AI never scores its own viva — same human-in-the-loop principle as
// EX036 and AI037 — a real TRAINER/EXAMINATION_OFFICER/SUPER_ADMIN
// confirms the final score after listening to (or reading) the transcript.
model AiVivaSession {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  unit          String   // unit title/code used for curriculum grounding — same free-text shape lib/curriculum.ts already takes
  assessmentId  String?  // set when this viva is tied to a specific scheduled oral Assessment, null for open practice
  assessment    Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  turns         AiVivaTurn[]

  score         Float?
  feedback      String?
  scoredById    String?
  scoredBy      User?    @relation("AiVivaSessionScorer", fields: [scoredById], references: [id])
  scoredAt      DateTime?

  @@index([studentId])
  @@index([assessmentId])
  @@index([scoredAt])
}

model AiVivaTurn {
  id              String   @id @default(cuid())
  sessionId       String
  session         AiVivaSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role            String   // student | examiner (the AI counterpart)
  content         String
  // Real, honestly-scoped provenance: was this turn actually captured via
  // the Web Speech API (spokenInput=true) or typed as a text fallback
  // (e.g. an unsupported browser) — never claimed as spoken if it wasn't.
  spokenInput     Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([sessionId])
}

// FN006/FN007 — card payment gateway. Same honesty precedent as
// PendingMpesaPush/DARAJA_*: real request/response handling against a real
// provider's REST API (Stripe Checkout Sessions, chosen because its API is
// plain HTTPS+JSON, so it needs no new npm dependency), returns a clear
// configuration error instead of a fake success when credentials aren't
// set, and has never executed against a real key in this sandbox (no
// network access). Set CARD_GATEWAY_SECRET_KEY / CARD_GATEWAY_WEBHOOK_SECRET
// to go live once a real merchant account exists.
model PendingCardCheckout {
  id                String   @id @default(cuid())
  checkoutSessionId String   @unique
  invoiceId         String
  amount            Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
}

// AI014 — course delivery/pacing plan. The genuinely-buildable-without-new-
// infrastructure half of "AI Teacher (full course)": sequencing and pacing
// a whole syllabus, grounded in the course's own real Lesson rows, not an
// autonomously-teaching agent (that would need a real tutoring engine this
// project doesn't claim to have — the per-question tutor at /ai/tutor
// remains the real, separate, one-exchange-at-a-time feature it always
// was). A trainer generates a draft with AI, can edit every item, and only
// a trainer-published plan is ever shown to students — the AI drafts, a
// human decides, same operating principle as every other AI feature in
// this codebase.
model CourseDeliveryPlan {
  id            String   @id @default(cuid())
  courseId      String   @unique
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  totalWeeks    Int
  generatedAt   DateTime @default(now())
  publishedAt   DateTime?
  publishedById String?
  items         CourseDeliveryPlanItem[]
}

model CourseDeliveryPlanItem {
  id          String   @id @default(cuid())
  planId      String
  plan        CourseDeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber  Int
  lessonId    String?  // links back to a real Lesson when the plan sequences an existing one
  title       String
  objective   String
  order       Int

  @@index([planId])
}

// EX014 — candidate admit cards. A real, printable/emailable card an
// invigilator checks by eye against the student in front of them — this is
// deliberately NOT biometric verification (see EX014's permanent-scope-
// boundary note in feature-audit-400.md, which stays unchanged). The photo
// is a snapshot of Student.photoDataUrl at issue time, so a later profile
// photo change doesn't silently invalidate an already-printed card.
model ExamAdmitCard {
  id              String   @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  photoDataUrl    String?  @db.Text
  documentId      String   @unique
  signedHash      String
  verificationUrl String
  issuedAt        DateTime @default(now())

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
}

// ---------------------------------------------------------------------------
// VIRTUAL BUSINESS LAB (VBL) INTEGRATION — Batch 65, namespace VBI.
// Measur Business College stays the system of record for identity, enrollment and official
// grades; VBL stays the system of record for simulation/practical activity.
// See docs/VBL_MAIN_PORTAL_INTEGRATION_ARCHITECTURE.md for the full design
// and docs/VBL_MAIN_PORTAL_INTEGRATION_AUDIT.md for what this batch did and
// did not cover. Additive only — no existing model/field above is touched.
// ---------------------------------------------------------------------------

// VBI014/017 — direction + lifecycle of one synchronization event.
enum IntegrationDirection {
  PORTAL_TO_VBL
  VBL_TO_PORTAL
}

enum IntegrationEventStatus {
  PENDING
  PROCESSING
  SENT // outbound: delivered and acknowledged by the other side
  RECEIVED // inbound: processed successfully
  FAILED
  DEAD_LETTER
  DUPLICATE_IGNORED
}

// VBI022/025 — a VBL assessment/competency result on its way into the
// official gradebook. Deliberately its own model, never written directly
// into Submission/Transcript, so a VBL score can never silently become an
// official grade without passing through approve()/reject().
enum LabResultStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVERSED
}

// VBI001 — Lab Identity Mapping. One row per student who has ever touched
// the Lab; the Lab never gets to invent its own notion of who someone is.
model IntegrationStudentMapping {
  id               String    @id @default(cuid())
  studentId        String    @unique
  student          Student   @relation(fields: [studentId], references: [id])
  labUserId        String?   @unique // VBL users.id once provisioned; null until first SSO/enrollment sync
  labInstitutionCode String? // VBL institutions.code this student was provisioned into
  status           String    @default("ACTIVE") // ACTIVE | SUSPENDED (mirrors Student.academicStatus at last sync)
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// VBI002 — Lab Staff Mapping. Same idea, for trainers.
model IntegrationStaffMapping {
  id               String    @id @default(cuid())
  trainerId        String    @unique
  trainer          Trainer   @relation(fields: [trainerId], references: [id])
  labUserId        String?   @unique
  labInstitutionCode String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// VBI003 — Course Mapping. Enrollment in this schema is keyed on Unit (see
// Enrollment/Unit above), so the Lab-side counterpart of "a course" here is
// a Unit, mapped to a VBL programme + cohort (VBL has no separate "course").
model IntegrationCourseMapping {
  id              String    @id @default(cuid())
  unitId          String    @unique
  unit            Unit      @relation(fields: [unitId], references: [id])
  labProgrammeId  String? // VBL programmes.id
  labCohortId     String? // VBL cohorts.id new enrollments are added to
  labCourseCode   String? // human-readable label shown in the sync dashboard
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// VBI017 — Integration Event Ledger. Every attempted synchronization in
// either direction, keyed by an idempotent eventId so a retried/duplicated
// delivery is provably processed at most once (VBI014).
model IntegrationEvent {
  id             String                 @id @default(cuid())
  eventId        String                 @unique // idempotency key, generated by the sender
  direction      IntegrationDirection
  eventType      String // e.g. "enrollment.created", "assessment.decided"
  entityType     String? // e.g. "Enrollment", "VirtualLabAssessmentResult"
  entityId       String?
  payload        Json
  payloadHash    String
  status         IntegrationEventStatus @default(PENDING)
  attempts       Int                    @default(0)
  lastError      String?
  processedAt    DateTime?
  // Batch 66 — VBI015: earliest time an outbound PENDING/FAILED event may be attempted again.
  // Doubles as a short lease while a dispatcher holds the row (see integration/events.ts
  // claimDueEvents), so two portal instances never send the same event concurrently.
  nextAttemptAt  DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status])
  @@index([direction, status])
  @@index([direction, status, nextAttemptAt])
  @@index([eventType])
}

// VBI018/019/021/022 — a practical result reported by the Lab, pending the
// portal-side human approval workflow before it can affect the official
// gradebook (see routes/integration-vbl.ts approveLabResult / rejectLabResult).
model VirtualLabAssessmentResult {
  id                  String          @id @default(cuid())
  studentId           String
  student             Student         @relation(fields: [studentId], references: [id])
  unitId              String
  unit                Unit            @relation(fields: [unitId], references: [id])
  externalAssessmentId String         @unique // VBL assessment_attempts.id
  competencyCode      String?
  outcome             String // COMPETENT | NOT_YET_COMPETENT (VBL's own vocabulary — see audit doc)
  feedback            String?         @db.Text
  assessorLabUserId   String? // VBL assessor's user id (for traceability; not necessarily a portal Trainer)
  decidedAt           DateTime
  status              LabResultStatus @default(PENDING_APPROVAL)
  reviewedById        String? // portal User.id of the trainer/admin who approved/rejected
  reviewedAt          DateTime?
  reviewNote          String?
  sourceEventId       String          @unique // the IntegrationEvent.eventId this came from
  // Batch 65 — VBI020/031: an evidence *reference*, not a copy — VBL stays
  // the system of record for the actual evidence content.
  evidenceId          String?
  evidenceVersion     Int?
  evidenceSourceType  String?
  evidenceSourceRef   String?
  evidenceContentHash String?
  // Batch 65 — VBI023: which earlier (immutable) result this one supersedes,
  // when VBL reports a resubmission chain — see AssessmentService.decide's
  // comment on why VBL amendments are always a NEW record, never a mutation.
  supersedesResultId  String?         @unique
  supersedes          VirtualLabAssessmentResult?  @relation("ResultChain", fields: [supersedesResultId], references: [id])
  supersededBy        VirtualLabAssessmentResult?  @relation("ResultChain")
  // Batch 65 — VBI024: reversal of an already-APPROVED result. Kept
  // separate from reviewedBy/reviewedAt/reviewNote so the original
  // approval is never overwritten — both are visible.
  reversedById        String?
  reversedAt          DateTime?
  reversalReason      String?
  // Batch 66 — VBI027: the Lab's own per-criterion met/not-met breakdown, exactly as sent
  // ([{ code, name?, met, comment? }]). Null when the Lab sent none.
  criteria            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Batch 65 — VBI028/029: which portal LearningOutcome this Lab competency
  // maps to (looked up via IntegrationCompetencyMapping at ingest time).
  learningOutcomeId   String?
  learningOutcome     LearningOutcome? @relation(fields: [learningOutcomeId], references: [id])
  // Batch 65 — VBI025/034: the Submission this APPROVED result was posted
  // into, once posted. Null until approve() successfully posts it (e.g. no
  // IntegrationGradebookMapping exists yet for this unit — see the audit
  // doc), and cleared back to a zero/annotated Submission on reversal
  // rather than deleted (grade history should never just vanish).
  postedSubmission    Submission?
  postedAt            DateTime?

  @@index([studentId])
  @@index([unitId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Batch 65 continued — VBI025/026/027: Gradebook Mapping. One VBL-enabled
// Unit maps to exactly one Assessment "component" that an APPROVED Lab
// result posts a score into (see routes/integration-vbl.ts postApprovedResultToGradebook).
// Deliberately one component per unit for this batch, not a general N-component
// weighting engine — see docs/VBL_MAIN_PORTAL_INTEGRATION_AUDIT.md for the
// larger gradebook-weighting feature this intentionally does not attempt.
// VBI027 (Rubric Mapping) rides along here: rubricNote is shown alongside
// the posted score so a trainer can see how VBL's own rubric criteria
// informed the outcome, without trying to force VBL's binary
// COMPETENT/NOT_YET_COMPETENT criteria into the portal's numeric Rubric.criteria shape.
// ---------------------------------------------------------------------------
model IntegrationGradebookMapping {
  id                          String   @id @default(cuid())
  unitId                      String   @unique
  unit                        Unit     @relation(fields: [unitId], references: [id])
  assessmentId                String
  assessment                  Assessment @relation(fields: [assessmentId], references: [id])
  competentScorePercent       Float    @default(100)
  notYetCompetentScorePercent Float    @default(0)
  rubricNote                  String?  @db.Text
  createdById                 String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  rubricCriterionMappings     IntegrationRubricCriterionMapping[] // Batch 66 — VBI027
}

// VBI028/029 — Competency Mapping: which portal LearningOutcome a given VBL
// competency code (scoped to a Unit) represents. Looked up at ingest time
// in routeVblEvent so every VirtualLabAssessmentResult carries a real
// LearningOutcome link, not just the raw string VBL sent.
model IntegrationCompetencyMapping {
  id                String          @id @default(cuid())
  unitId            String
  unit              Unit            @relation(fields: [unitId], references: [id])
  labCompetencyCode String
  learningOutcomeId String
  learningOutcome   LearningOutcome @relation(fields: [learningOutcomeId], references: [id])
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([unitId, labCompetencyCode])
}

// ---------------------------------------------------------------------------
// Batch 65 continued — VBI010/045: rotating, keyed webhook credentials. A
// direction can have more than one ACTIVE credential at once (old + new,
// during a rotation window); dispatch/verification tries every ACTIVE
// credential for the relevant direction. Storing the raw secret (not just a
// hash) is required here — HMAC verification needs it — same trust model as
// the PORTAL_WEBHOOK_SECRET/VBL_WEBHOOK_SECRET env vars this table
// supersedes; a production deployment would keep `secret` in a KMS/secrets
// manager rather than this column (documented limitation, not hidden).
// ---------------------------------------------------------------------------
enum IntegrationCredentialDirection {
  PORTAL_TO_VBL // signs events the portal sends to VBL
  VBL_TO_PORTAL // verifies events VBL sends to the portal
}

enum IntegrationCredentialStatus {
  ACTIVE
  REVOKED
}

model IntegrationCredential {
  id          String                          @id @default(cuid())
  keyId       String                          @unique // sent alongside the signature so the verifier knows which secret to try first
  secret      String // see model comment — belongs in a KMS in production
  direction   IntegrationCredentialDirection
  status      IntegrationCredentialStatus     @default(ACTIVE)
  createdById String
  createdAt   DateTime                        @default(now())
  revokedById String?
  revokedAt   DateTime?
  notes       String?

  @@index([direction, status])
}

// ---------------------------------------------------------------------------
// BATCH 66 — Postgres-backed replacements for what used to be in-process state,
// plus the remaining VBL-integration gaps. Additive only.
// ---------------------------------------------------------------------------

// VBI044 — shared rate-limit store. One row per limiter key; the fixed window is reset
// atomically in a single INSERT ... ON CONFLICT statement (integration/rate-limit.ts), so the
// limit holds across any number of portal instances (the old limiter was a per-process Map).
model IntegrationRateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}

// VBI036 — Lab Activity Synchronization. Every activity.logged event is now stored as a
// queryable row (previously: one audit-log line, evidence capture only). activityType is the
// Lab's own dotted vocabulary (evidence.capture, scenario.started, transaction.posted, ...);
// unknown types are stored as-is rather than dropped.
model VirtualLabActivity {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id])
  activityType  String
  entityType    String?
  entityRef     String?
  summary       String?
  data          Json?
  occurredAt    DateTime
  sourceEventId String   @unique
  createdAt     DateTime @default(now())

  @@index([studentId, occurredAt])
  @@index([unitId])
  @@index([activityType])
}

// VBI027 — Rubric Mapping, criterion by criterion: which portal Rubric criterion (by its
// name inside Rubric.criteria) a given Lab criterion code stands for, scoped to the unit's
// gradebook mapping. Used when posting an approved result to build Submission.criteriaScores.
model IntegrationRubricCriterionMapping {
  id                  String                      @id @default(cuid())
  gradebookMappingId  String
  gradebookMapping    IntegrationGradebookMapping @relation(fields: [gradebookMappingId], references: [id], onDelete: Cascade)
  labCriterionCode    String
  rubricCriterionName String
  createdById         String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([gradebookMappingId, labCriterionCode])
}

// KFX-004 / KSEC-023 — single-use password recovery tokens. Only the SHA-256 of the emailed token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}


// Batch 69 — KFEAT-082 / KFX-017: per-user delivery channels and muted categories.
model NotificationPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inApp           Boolean  @default(true)
  email           Boolean  @default(true)
  sms             Boolean  @default(false)
  mutedCategories String[] @default([]) // fees | logbook | announcement | academic
  updatedAt       DateTime @updatedAt
}

// Batch 69 — KFEAT-066/070/073/059: admin-editable configuration (validated per key in lib/settings.ts).
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Batch 69 — KOBS-005/009: one row per background/maintenance job execution.
model ScheduledJobRun {
  id         String    @id @default(cuid())
  job        String
  trigger    String    @default("scheduler") // scheduler | manual
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    Json?
  error      String?

  @@index([job, startedAt])
}


// Batch 70 — KDATA-007: data-subject requests (access, correction, erasure, ...) with a response deadline.
model DataRequest {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String    // access | correction | erasure | restriction | objection
  details        String?
  status         String    @default("received") // received | in_progress | completed | rejected
  dueAt          DateTime
  handledById    String?
  resolutionNote String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([status, dueAt])
  @@index([userId])
}

// Batch 70 — KFEAT-054 / KFX-021 / KFX-048 / KDB-010: replay store for the Idempotency-Key header.
model IdempotencyRecord {
  id             String   @id @default(cuid())
  scope          String   // user id, or ip:<addr> for public forms
  key            String
  route          String
  bodyHash       String
  status         String   @default("in_progress") // in_progress | done
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  @@unique([scope, key])
  @@index([createdAt])
}


// Batch 71 — KOBS-013/017/018: incidents and planned maintenance shown to users and counted for availability.
model ServiceNotice {
  id          String    @id @default(cuid())
  kind        String    // incident | maintenance
  severity    String    @default("minor") // minor | major (major counts against availability)
  title       String
  message     String
  status      String    @default("active") // active | resolved | cancelled
  startsAt    DateTime  @default(now())
  endsAt      DateTime? // maintenance: planned end; incident: when it was resolved
  updates     Json      @default("[]") // [{at, by, text}]
  createdById String
  createdAt   DateTime  @default(now())

  @@index([status, startsAt])
}

// Batch 71 — KFEAT-125: every lookup of a document ID through the public verifier (IP stored only as a keyed hash).
model CredentialVerification {
  id         String   @id @default(cuid())
  documentId String
  found      Boolean
  revoked    Boolean  @default(false)
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// BATCH 77 — LMS extras (content, gradebook, communication). All additive.
// Plain string ids (no relations) so nothing existing has to change.
// ---------------------------------------------------------------------------

// CNT051 — a student's saved lessons.
model LessonBookmark {
  id            String   @id @default(cuid())
  studentUserId String
  lessonId      String
  courseId      String
  createdAt     DateTime @default(now())

  @@unique([studentUserId, lessonId])
  @@index([studentUserId, courseId])
}

// CNT052 — private notes a student keeps against a lesson.
model LessonNote {
  id            String   @id @default(cuid())
  studentUserId String
  lessonId      String
  courseId      String
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([studentUserId, lessonId])
}

// CNT059 — one row per lesson open (who/when), for content view analytics.
model LessonView {
  id            String   @id @default(cuid())
  userId        String
  lessonId      String
  courseId      String
  viewedAt      DateTime @default(now())

  @@index([courseId, viewedAt])
  @@index([lessonId])
}

// CNT058 — one row per attachment download.
model MaterialDownload {
  id            String   @id @default(cuid())
  userId        String
  attachmentId  String?
  assetId       String
  courseId      String
  downloadedAt  DateTime @default(now())

  @@index([courseId, downloadedAt])
  @@index([assetId])
}

// CNT045/025/056/057 — downloadable materials attached to a lesson.
model LessonAttachment {
  id           String   @id @default(cuid())
  lessonId     String
  courseId     String
  assetId      String
  label        String
  downloadable Boolean  @default(true)
  audience     String   @default("ENROLLED") // ENROLLED | STAFF   (CNT057)
  version      Int      @default(1)          // bumps when the file is replaced (CNT056)
  previousAssetIds String[] @default([])
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([lessonId])
  @@index([courseId])
}

// CNT047 — reusable lesson templates.
model LessonTemplate {
  id          String   @id @default(cuid())
  ownerUserId String
  name        String
  description String?
  contentType String   @default("reading")
  contentBody String?
  blocks      Json?
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ownerUserId])
}

// CNT043 — reviewer feedback on a lesson (QA, coordinator or fellow trainer).
model LessonReviewComment {
  id         String   @id @default(cuid())
  lessonId   String
  courseId   String
  authorId   String
  body       String
  status     String   @default("OPEN") // OPEN | RESOLVED
  resolvedById String?
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([lessonId])
}

// GRD005-009/016 — how much each category counts towards a course's overall grade.
model GradeWeight {
  id            String   @id @default(cuid())
  courseId      String
  category      String   // FORMATIVE_QUIZ | ASSIGNMENT | PRACTICAL | PROJECT | CAT | FINAL_EXAM
  weightPercent Float
  updatedById   String
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([courseId, category])
}

// COM009 — forum subscriptions (new posts notify subscribers).
model ForumSubscription {
  id        String   @id @default(cuid())
  userId    String
  forumId   String
  createdAt DateTime @default(now())

  @@unique([userId, forumId])
}

// PRG028 — an intervention a trainer opens for a student who is struggling.
model SupportIntervention {
  id            String   @id @default(cuid())
  courseId      String
  studentUserId String
  openedById    String
  reason        String
  action        String?
  status        String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  outcome       String?
  createdAt     DateTime @default(now())
  closedAt      DateTime?

  @@index([courseId, status])
  @@index([studentUserId])
}
