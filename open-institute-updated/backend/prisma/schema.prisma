  committee    String   // Board | Academic Board | QA Committee | Examination Board
  title        String
  scheduledAt  DateTime
  status       String   @default("scheduled") // scheduled | held | cancelled
  agendaItems  AgendaItem[]
  minutesText  String?
  createdAt    DateTime @default(now())

  managementReviews ManagementReview[]

  // Batch 53 — RG029/RG030
  examBoardRatifications     ExamBoardRatification[]
  academicBoardRatifications AcademicBoardRatification[]
}

// ---------------------------------------------------------------------------
// RG029/RG030/RG036 — Examination Board, Academic Board, regulatory returns
// ---------------------------------------------------------------------------

// RG029 — Examination Board: a dedicated ratification record distinct from
// a generic Meeting/AgendaItem resolution. Ties one unit's finalized results
// (see lib/results-processing.ts, RG025) to the specific board meeting that
// ratified them, capturing the pass rate *at the moment of ratification* so
// a later results amendment (RG026) doesn't silently rewrite board history.
model ExamBoardRatification {
  id              String   @id @default(cuid())
  meetingId       String
  meeting         Meeting  @relation(fields: [meetingId], references: [id])
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  studentsCovered Int
  passRate        Float?
  notes           String?
  ratifiedById    String
  ratifiedBy      User     @relation("ExamBoardRatifiedBy", fields: [ratifiedById], references: [id])
  ratifiedAt      DateTime @default(now())

  @@unique([meetingId, courseId])
  @@index([courseId])
}

// RG030 — Academic Board: the institutional ratification of a graduation
// decision for one student at one board meeting — the sign-off that sits
// above GraduationClearance (RG017, the registrar's own eligibility check).
// One row per student so a board deferring one student in a cohort never
// blocks ratifying the rest. Ratifying "graduate" is a real event: it moves
// Student.academicStatus to GRADUATED (see governance.ts).
model AcademicBoardRatification {
  id           String   @id @default(cuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id])
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  decision     String   // graduate | defer | withhold
  notes        String?
  ratifiedById String
  ratifiedBy   User     @relation("AcademicBoardRatifiedBy", fields: [ratifiedById], references: [id])
  ratifiedAt   DateTime @default(now())

  @@unique([meetingId, studentId])
  @@index([studentId])
}

// RG036 — Government reporting: a log of regulatory data returns for any
// regulator other than KUCCPS (which already has its own exchange-format
// pair, KuccpsExportBatch/KuccpsImportBatch). Kept separate rather than
// generalizing the KUCCPS models, since those two carry KUCCPS-specific
// fields (matchedCount) that a TVETA/KNQA return has no use for.
model RegulatoryReportBatch {
  id            String   @id @default(cuid())
  regulator     String   // TVETA | KNQA | CDACC | ODPC
  reportType    String
  recordCount   Int
  generatedById String
  generatedBy   User     @relation("RegulatoryReportsGenerated", fields: [generatedById], references: [id])
  createdAt     DateTime @default(now())
}

model AgendaItem {
  id         String   @id @default(cuid())
  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id])
  title      String
  order      Int
  resolution String?
  actionOwner String?
  actionDueDate DateTime?
  status     String   @default("open") // open | resolved | deferred
}

