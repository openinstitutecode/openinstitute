// ---------------------------------------------------------------------------
// PROCUREMENT, EXPENSES & ASSETS (basic ERP)
// ---------------------------------------------------------------------------

model Supplier {
  id           String   @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  description String
  amount      Decimal  @db.Decimal(10, 2)
  status      String   @default("draft") // draft | approved | ordered | received | cancelled
  requestedById String
  approvedById  String?
  createdAt   DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  category    String   // utilities | salaries | maintenance | supplies | other
  description String
  amount      Decimal  @db.Decimal(10, 2)
  incurredAt  DateTime
  approvedById String?
  paidAt      DateTime? // null = still an outstanding Accounts Payable liability
  programmeId String?  // optional: direct-attributed to one programme for FN035 economics; null = institution-wide overhead
  programme   Programme? @relation(fields: [programmeId], references: [id])
  createdAt   DateTime @default(now())

  journalEntries JournalEntry[]
}

// ---------------------------------------------------------------------------
// FN023/024 — general ledger and chart of accounts. Real double-entry
// bookkeeping: every JournalEntry's lines must sum debits = credits before
// the route will persist it (enforced in code, not just trusted). Accounts
// are seeded lazily on first use (ensureDefaultAccounts in lib/ledger.ts)
// rather than requiring a separate migration/seed run.
// ---------------------------------------------------------------------------

model ChartOfAccount {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String   // asset | liability | equity | revenue | expense
  createdAt DateTime @default(now())

  debitLines  JournalLine[] @relation("DebitAccount")
  creditLines JournalLine[] @relation("CreditAccount")
}

model JournalEntry {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  description  String
  postedById   String?  // null = system-posted (e.g. auto-posted from a payment)
  sourceType   String?  // payment | expense | manual
  sourceId     String?
  expenseId    String?
  expense      Expense? @relation(fields: [expenseId], references: [id])
  createdAt    DateTime @default(now())

  lines JournalLine[]
}

model JournalLine {
  id             String        @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id])
  debitAccountId String?
  debitAccount   ChartOfAccount? @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String?
  creditAccount  ChartOfAccount? @relation("CreditAccount", fields: [creditAccountId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
}

// FN018 — financial holds: an explicit administrative block, separate from
// (and possibly in addition to) an unpaid fee balance. releasedAt being
// null is the single source of truth for "still active" — no separate
// boolean that could drift out of sync with it.
model FinancialHold {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  reason       String
  placedById   String
  placedAt     DateTime  @default(now())
  releasedById String?
  releasedAt   DateTime?
}

// FN010 — digital receipts, signed and verifiable the same way as a
// transcript/certificate/letter.
model Receipt {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  payment         Payment  @relation(fields: [paymentId], references: [id])
  documentId      String   @unique
  verificationUrl String
  signedHash      String
  issuedAt        DateTime @default(now())
}

// FN006/007 — tracks a pending M-Pesa STK push so the callback (which only
// gives us the amount and a CheckoutRequestID) can be matched back to the
// invoice it was for. Without this, the earlier callback handler had no
// way to know which invoice to credit — which is exactly why it never
// actually recorded a payment before this batch.
model PendingMpesaPush {
  id                String   @id @default(cuid())
  checkoutRequestId String   @unique
  invoiceId         String
  amount            Decimal  @db.Decimal(10, 2)
  phone             String
  createdAt         DateTime @default(now())
}

