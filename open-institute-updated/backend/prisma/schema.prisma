// ---------------------------------------------------------------------------
// COMPETENCY PASSPORT
// ---------------------------------------------------------------------------

model Competency {
  id          String   @id @default(cuid())
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now())

  records     CompetencyRecord[]
  evidenceSubmissions CompetencyEvidence[]
  microcredentials Microcredential[]
  questions   Question[]

  // TP009 — units whose curriculum has been mapped as building this competency
  unitCompetencies UnitCompetency[]
}

// TP009 — Competency mapping: explicit curriculum-to-competency mapping,
// distinct from CompetencyRecord (which tracks a *student's* attainment).
// This is the trainer/coordinator-facing map of which units actually teach
// towards which programme competencies — previously there was no link
// between Competency and Unit at all, only Competency <-> Programme.
model UnitCompetency {
  id           String     @id @default(cuid())
  unitId       String
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  mappedById   String
  mappedAt     DateTime   @default(now())

  @@unique([unitId, competencyId])
  @@index([unitId])
  @@index([competencyId])
}

model CompetencyRecord {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  competencyId    String
  competency      Competency @relation(fields: [competencyId], references: [id])
  level           String   @default("developing") // developing | competent | advanced
  evidenceSummary String?
  assessmentScore Float?
  trainerVerifiedById String?
  industryVerifiedByEmployerId String?
  achievedAt      DateTime?
  createdAt       DateTime @default(now())
}

// SP022 — competency evidence portfolio: a student-initiated submission,
// distinct from CompetencyRecord (which only a trainer/examiner can write).
// A trainer reviews it and, if accepted, creates or upgrades the student's
// CompetencyRecord — evidence never silently becomes a verified record on
// its own.
model CompetencyEvidence {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id])
  competencyId  String
  competency    Competency @relation(fields: [competencyId], references: [id])
  description   String
  evidenceUrl   String?
  status        String    @default("pending") // pending | accepted | rejected
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  submittedAt   DateTime  @default(now())
}

// SP030 — student knowledge notebook: notes the student saves themselves,
// including AI tutor explanations they choose to keep. Purely self-service
// storage — never read by anyone but the student who owns it.
model NotebookEntry {
  id            String   @id @default(cuid())
  studentUserId String
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id])
  title         String
  content       String
  sourceType    String   @default("manual") // manual | ai_tutor
  createdAt     DateTime @default(now())
}

// SP023 — digital portfolio: student-curated showcase of their own work
// (a project, a piece of research, a badge, an attachment outcome). Purely
// a display/organization layer over things the student already has —
// doesn't create or alter any academic record.
model PortfolioItem {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  title       String
  description String?
  category    String   // project | competency | badge | research | attachment | other
  linkUrl     String?
  addedAt     DateTime @default(now())
}

