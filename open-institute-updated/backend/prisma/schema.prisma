// QUALITY ASSURANCE / ACCREDITATION EVIDENCE
// ---------------------------------------------------------------------------

model CorrectiveAction {
  id           String   @id @default(cuid())
  complianceRequirementId String?
  requirement  ComplianceRequirement? @relation(fields: [complianceRequirementId], references: [id])
  description  String
  assignedToId String
  dueDate      DateTime?
  status       String   @default("open") // open | in_progress | verified | closed
  evidenceUrl  String?
  createdById  String
  createdAt    DateTime @default(now())
}

model ComplianceRequirement {
  id               String   @id @default(cuid())
  regulator        String   // TVETA | CUE | KUCCPS | KNQA | ODPC
  category         String   @default("general") // general | odel | facility | ict | learner_support | assessment | course_material
  requirement      String
  mandatory        Boolean  @default(true)
  status           String   @default("pending") // pending | in_progress | met | expired
  responsibleRole  Role?
  evidenceDocUrl   String?
  lastReviewedAt   DateTime?
  nextReviewDue    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  correctiveActions CorrectiveAction[]
  evidenceVersions  EvidenceVersion[]
}

// QA021 — evidence versioning: every time a requirement's evidence
// document is replaced, the previous one is kept here rather than
// overwritten — a real history, not just the current pointer.
model EvidenceVersion {
  id            String   @id @default(cuid())
  requirementId String
  requirement   ComplianceRequirement @relation(fields: [requirementId], references: [id])
  url           String
  uploadedById  String
  uploadedAt    DateTime @default(now())
}

// QA005 — quality standards: institutional benchmarks the QMS is meant to
// meet, distinct from a specific regulator's mandatory requirement
// (ComplianceRequirement) — a standard can exist even where no regulator
// currently mandates it.
model QualityStandard {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String?
  createdAt   DateTime @default(now())
}

// EX004 — Learning-outcome mapping: formal model to map questions/assessments
// to specific learning outcomes, distinct from the generic Question.topic
model LearningOutcome {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  code        String   // e.g., "LO-001"
  description String   // What the student should be able to do
  level       String   @default("understand") // remember, understand, apply, analyze, evaluate, create
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]

  // Batch 65 — VBI028/029: reverse sides of the Lab competency mapping.
  vblResults VirtualLabAssessmentResult[]
  vblCompetencyMappings IntegrationCompetencyMapping[]

  @@unique([unitId, code])
}

// EX007 — Examination blueprints: template definitions for creating exams with
// consistent structure (question distribution, difficulty levels, etc.)
model ExamBlueprint {
  id            String   @id @default(cuid())
  programmeId   String
  programme     Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  totalMarks    Int      @default(100)
  durationMinutes Int    @default(120)
  passMarks     Int      @default(50)
  
  // Structure: how many questions at each level?
  rememberCount    Int @default(5)
  understandCount  Int @default(10)
  applyCount       Int @default(8)
  analyzeCount     Int @default(5)
  evaluateCount    Int @default(2)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  assessments Assessment[] // assessments created from this blueprint
}

// QA003 — IQA (internal quality assurance) management: a self-initiated
// internal review, distinct from the more formal InternalAudit (QA028,
// typically external-facing) — this is the institution checking its own
// work on a recurring internal cycle.
model IqaReview {
  id             String   @id @default(cuid())
  scope          String   // what was reviewed — a unit, a programme, a department
  reviewedById   String
  findings       String
  actionsRequired String?
  reviewDate     DateTime @default(now())
  createdAt      DateTime @default(now())
}

// QA031 — management review: the periodic review of the QMS itself (not
// of one programme) — what was examined, what was decided, real inputs
// and outputs, optionally tied to a Meeting record.
model ManagementReview {
  id              String   @id @default(cuid())
  meetingId       String?
  meeting         Meeting? @relation(fields: [meetingId], references: [id])
  reviewDate      DateTime @default(now())
  inputsSummary   String
  decisionsSummary String
  conductedById   String
  createdAt       DateTime @default(now())
}

// QA035 — programme review: periodic quality review of one specific
// programme (distinct from ManagementReview, which reviews the QMS as a
// whole).
model ProgrammeReview {
  id                String   @id @default(cuid())
  programmeId       String
  programme         Programme @relation(fields: [programmeId], references: [id])
  reviewedById      String
  findings          String
  recommendedActions String?
  reviewDate        DateTime @default(now())
  nextReviewDue     DateTime?
  createdAt         DateTime @default(now())
}

// QA010 — institutional accreditation: the institution-wide status held
// with a regulator (e.g. TVETA institutional registration, CUE charter),
// distinct from QA009's AccreditationReview which is scored per
// programme. Before this there was no real record here at all — just the
// docs/regulatory-notes.md research file and whatever ComplianceRequirement
// rows happened to exist, neither of which is an actual accreditation
// certificate with a validity window.
model InstitutionalAccreditation {
  id             String   @id @default(cuid())
  regulator      String   // TVETA | CUE | KNQA | CDACC
  status         String   @default("pending") // pending | accredited | conditional | withdrawn | expired
  certificateUrl String?
  conditions     String?
  validFrom      DateTime?
  validUntil     DateTime?
  recordedById   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// QA014 — course approval: a real per-course review gate, distinct from
// QA009's programme-level accreditation. A Course could previously be
// published by any admin-course-role user with no review step at all;
// this gives a QA/coordinator sign-off a course can be routed through
// before it goes live, the same submit -> decide shape as programme
// accreditation.
model CourseApproval {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requestedById String
  status       String   @default("pending") // pending | approved | rejected
  notes        String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
}

// EX025 — external moderation: a real, distinct sign-off from an external
// examiner (Role.EXTERNAL_EXAMINER already exists), separate from the
// internal moderation workflow.
model ExternalModerationReview {
  id            String   @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  examinerId    String
  comments      String
  outcome       String   @default("pending") // pending | approved | changes_requested
  reviewedAt    DateTime @default(now())
}

// ===== BATCH 43 NEW MODELS =====

// SP024 — Persistent AI Tutor: sessions store conversation history and metadata
model TutorSession {
  id                String   @id @default(cuid())
  studentId         String
  student           User     @relation("TutorSessions", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  lastMessageAt     DateTime @default(now())
  messagesCount     Int      @default(0)
  sessionNotes      String?  // summary or notes by student
  isActive          Boolean  @default(true)
  // SP024 — which unit this session is about, so re-opening the AI Tutor
  // for a unit resumes the right conversation instead of an undifferentiated
  // 24-hour bucket, and so the model gets real prior-turn context.
  unit              String?
  difficulty        String?
  messages          TutorMessage[]
  
  @@index([studentId])
  @@index([lastMessageAt])
  @@index([studentId, unit])
}

// EX036 — Business simulation lab. Previously simulation.ts's POST /turn was
// entirely stateless: every turn was a one-shot AI call with no session, no
// transcript kept, and no way for a trainer to ever see or score what a
// student actually did in it — a "simulation assessment" in name only. This
// gives it a real session, a persisted transcript, and a trainer-confirmed
// score, the same shape AI033 (viva) correctly deferred building without
// speech infrastructure this system doesn't have — but the simulation lab
// only ever needed text, which this system already has.
model SimulationSession {
  id           String   @id @default(cuid())
  studentId    String
  student      User     @relation("SimulationSessionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  scenario     String
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  turns        SimulationTurn[]

  // A trainer-confirmed score, deliberately never auto-computed by the AI
  // partner itself — the same principle AI037's safety layer and AI033's
  // human-conducted viva both rest on: an AI counterpart is a practice
  // partner, not the assessor of its own conversation.
  score        Float?
  feedback     String?
  scoredById   String?
  scoredBy     User?    @relation("SimulationSessionScorer", fields: [scoredById], references: [id])
  scoredAt     DateTime?

  @@index([studentId])
  @@index([scoredAt])
}

model SimulationTurn {
  id                  String   @id @default(cuid())
  simulationSessionId String
  simulationSession   SimulationSession @relation(fields: [simulationSessionId], references: [id], onDelete: Cascade)
  role                String   // student | partner (the AI counterpart)
  content             String
  createdAt           DateTime @default(now())

  @@index([simulationSessionId])
}

model TutorMessage {
  id             String   @id @default(cuid())
  sessionId      String
  session        TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           String   // "student" | "tutor"
  content        String
  timestamp      DateTime @default(now())
  
  @@index([sessionId])
}

// LMS039 — Accessibility preferences: user-level display/readability settings
model UserAccessibilityPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fontSize            Int      @default(16)    // px: 14, 16, 18, 20
  lineHeight          Float    @default(1.5)   // 1.5, 1.8, 2.0
  contrastMode        String   @default("normal") // normal | high
  dyslexiaFriendlyFont Boolean @default(false)
  reducedMotion       Boolean  @default(false)
  screenReaderOptimized Boolean @default(false)
  // LMS025 — low-bandwidth mode: when true, LessonView skips autoplay,
  // defers images/video behind a tap-to-load placeholder, and prefers a
  // lesson's text (contentBody) over its media where both exist.
  lowBandwidthMode    Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  
  @@index([userId])
}

// AD027 — Dynamic role-based permissions: extends the fixed enum with fine-grained control
model RolePermission {
