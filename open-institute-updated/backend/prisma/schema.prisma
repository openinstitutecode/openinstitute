  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  role           String         // user | assistant
  content        String
  sourceRefs     String[]       // curriculum/material IDs cited by the assistant
  createdAt      DateTime       @default(now())
}

// AI001/AI004 — every call that passes through lib/ai-gateway.ts writes one
// row here, whether it succeeded, failed, or was refused by the safety
// layer (AI037). `feature` is the key from AI_FEATURE_CATALOG (ai-
// gateway.ts) — e.g. "tutor", "marking-assistant" — so usage can be
// broken down per AI feature, not just a global count. This is the only
// thing in the codebase that tracks AI usage; AI040's governance routes
// read this table.
// AI002 — Model management. Through batch 61, the model id was a literal
// string ("claude-sonnet-4-6") hard-coded inside callAnthropic() in
// lib/ai-gateway.ts — the only way to point the institution's AI features
// at a different model was to edit source code and redeploy. This is a
// real, database-backed, admin-editable override: a singleton row (id
// "default") read by the gateway on every call, falling back to the
// hard-coded constant when no row exists yet (so a fresh install behaves
// exactly as before this batch). Still genuinely only "anthropic" is a
// wired provider (AI003) — this manages which model *within* that
// provider is called, and records who changed it and when, not a
// multi-provider model registry.
model AiModelConfig {
  id          String   @id @default("default")
  modelId     String   @default("claude-sonnet-4-6")
  notes       String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model AiUsageLog {
  id              String   @id @default(cuid())
  feature         String
  userId          String
  role            String
  success         Boolean
  blockedBySafety Boolean  @default(false)
  errorReason     String?  // "no_api_key" | "provider_error" | "blocked_by_safety" | "unconfigured_provider" | null on success
  promptChars     Int
  responseChars   Int      @default(0)
  latencyMs       Int
  createdAt       DateTime @default(now())

  @@index([feature])
  @@index([createdAt])
  @@index([userId])
}

