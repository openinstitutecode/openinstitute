// ---------------------------------------------------------------------------
// TP026 — Live teaching: real-time video sessions backed directly by a
// BigBlueButton server's documented REST API (checksummed create/join/end
// calls — see lib/bigbluebutton.ts). Deliberately independent of the
// Moodle-only bigbluebuttonbn reader in moodle/liveClasses.ts, which only
// helps MOODLE-engine courses and needs a running Moodle instance; this
// covers CUSTOM-engine courses, which are the majority of the catalogue.
// ---------------------------------------------------------------------------
model LiveClassSession {
  id                String           @id @default(cuid())
  courseId          String
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  hostUserId        String
  host              User             @relation("LiveClassHost", fields: [hostUserId], references: [id])
  meetingId         String           @unique
  moderatorPassword String
  attendeePassword  String
  scheduledAt       DateTime
  durationMinutes   Int              @default(60)
  status            LiveClassStatus  @default(SCHEDULED)
  startedAt         DateTime?
  endedAt           DateTime?
  createdAt         DateTime         @default(now())

  // TP026 — a session runs either in the built-in BigBlueButton room
  // ("BBB", needs BBB_SERVER_URL/BBB_SHARED_SECRET) or in any external
  // meeting the trainer already uses ("EXTERNAL": Google Meet / Zoom /
  // Teams link). EXTERNAL needs no server-side infrastructure, so live
  // teaching works on every deployment.
  provider          String           @default("BBB")
  externalUrl       String?
  description       String?
  recordingUrl      String?          // trainer-attached recording, shown to students after the session
  attendanceSyncedAt DateTime?
  attendees         LiveClassAttendee[]

  @@index([courseId])
  @@index([status])
}

// TP026 — who actually opened the join link for a session (a server-side
// record, written when the join URL is issued), so attendance can be taken
// from real participation instead of retyped by hand.
model LiveClassAttendee {
  id        String           @id @default(cuid())
  sessionId String
  session   LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  role      String           // host | attendee
  joinedAt  DateTime         @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// AD025 — GENERIC WORKFLOW ENGINE
// ---------------------------------------------------------------------------
// Batch 52. A real, reusable multi-stage approval engine — not another
// hardcoded per-module chain like ResultsApprovalChain or
// CreditTransferRequest. Any admin can define an ordered set of stages
// (each gated to a role) once, then start real instances of it against
// any entity, with a genuine audit trail of who acted, when, and with
// what comment. This batch wires two real callers onto it: Programme
// approval (AD010, via `POST /programmes/:id/approval-workflow`) can
// optionally be routed through a defined workflow instead of a single
// approvalStatus flip, and the new Executive Decision Centre (AD040)
// uses it to drive cross-functional decisions to a real resolution.
// Honest scope note: existing hardcoded chains are NOT migrated onto
// this engine in this batch — rewriting already-working, already-tested
// approval flows (results, credit transfer, programme accreditation)
// onto a new generic engine is a much larger and riskier change than
// shipping the engine itself. This ships a real, working engine plus
// real, working new usage — not a promised migration that wasn't done.
model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("general") // free-text grouping, e.g. programme_approval | executive_decision | general
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  stages    WorkflowStage[]
  instances WorkflowInstance[]
}

model WorkflowStage {
  id           String             @id @default(cuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  order        Int
  name         String
  approverRole Role               // who may approve/reject at this stage
  createdAt    DateTime           @default(now())

  @@unique([definitionId, order])
  @@index([definitionId])
}

model WorkflowInstance {
  id                String             @id @default(cuid())
  definitionId      String
  definition        WorkflowDefinition @relation(fields: [definitionId], references: [id])
  title             String
  entityType        String?            // free-text label of what this instance tracks, e.g. "programme"
  entityId          String?            // id of the real record this instance is attached to, if any
  currentStageOrder Int                @default(1)
  status            String             @default("in_progress") // in_progress | approved | rejected | cancelled
  startedById       String
  startedAt         DateTime           @default(now())
  completedAt       DateTime?

  actions           WorkflowStageAction[]
  executiveDecision ExecutiveDecision?

  @@index([definitionId])
  @@index([status])
  @@index([entityType, entityId])
}

model WorkflowStageAction {
  id         String           @id @default(cuid())
  instanceId String
  instance   WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stageOrder Int
  action     String           // approve | reject | comment
  actedById  String
  comment    String?
  actedAt    DateTime         @default(now())

  @@index([instanceId])
}

// ---------------------------------------------------------------------------
// AD040 — EXECUTIVE DECISION CENTRE
// ---------------------------------------------------------------------------
// Batch 52. Turns a Command Centre alert from an ephemeral banner into a
// real, owned, trackable record: who owns it, by when, at what priority —
// and, for anything needing cross-functional sign-off, a real
// WorkflowInstance (AD025) driving it to resolution instead of a single
// person's unaudited say-so.
model ExecutiveDecision {
  id                 String            @id @default(cuid())
  title              String
  sourceAlert        String            // which Command Centre signal prompted this, kept as free text
  rationale          String?
  ownerId            String
  priority           String            @default("medium") // low | medium | high
  dueDate            DateTime?
  status             String            @default("open")   // open | in_progress | resolved | dismissed
  workflowInstanceId String?           @unique
  workflowInstance   WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id])
  createdById        String
  createdAt          DateTime          @default(now())
  resolvedAt         DateTime?
  outcome            String?

  @@index([status])
}

