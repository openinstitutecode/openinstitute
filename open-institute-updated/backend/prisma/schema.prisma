// an attempt by itself.
model ExamActivityEvent {
  id         String   @id @default(cuid())
  sessionId  String
  session    ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType  String   // tab_hidden | tab_visible | fullscreen_exit | copy | paste
  occurredAt DateTime @default(now())

  @@index([sessionId])
  @@index([occurredAt])
}

// EX018 — Batch 56: exam-specific accessibility accommodations (distinct
// from the general AccommodationRequest model above, which has no notion
// of *which* assessment or *how much* extra time). Granting one here
// actually changes the deadline computed in GET /exams/assessments/:id/take
// and POST /exams/submissions/answers — see lib/quiz-scoring.ts's
// attemptDeadline, which now takes an extraMinutes argument.
model ExamAccommodation {
  id              String   @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentUserId   String
  extraTimeMinutes Int     @default(0)
  notes           String?
  status          String   @default("approved") // approved | revoked
  grantedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([assessmentId, studentUserId])
  @@index([assessmentId])
}

// EX034 — Batch 56: practical/competency-based assessment. TVET practical
// assessments are conventionally scored per-criterion as
// competent/not-yet-competent (CBET), not as marks-out-of-total the way
// EX021's Rubric is — so this is a distinct model from Rubric rather than
// a reuse of it. Overall outcome is computed (never separately typed) from
// the per-criterion calls, same principle as EX021's criteriaScores.
model PracticalChecklist {
  id           String   @id @default(cuid())
  assessmentId String   @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  criteria     Json     // [{ name, description, mandatory: boolean }]
  createdById  String
  createdAt    DateTime @default(now())

  results      PracticalChecklistResult[]
}

model PracticalChecklistResult {
  id            String   @id @default(cuid())
  checklistId   String
  checklist     PracticalChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  submissionId  String   @unique
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criteriaCalls Json     // [{ name, competent: boolean, comment?: string }] — one call per checklist criterion
  overallOutcome String  // computed: "competent" | "not_yet_competent"
  assessedById  String
  assessedAt    DateTime @default(now())
}

// EX032 — Similarity checking: track pairwise plagiarism analysis
model SimilarityCheck {
  id                    String   @id @default(cuid())
  assessmentId          String
  assessment            Assessment @relation(fields: [assessmentId], references: [id])
  submissionId          String
  submission            Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  pairedSubmissionId    String? // which other submission this was compared to
  pairedSubmission      Submission? @relation("SimilarityCheckPaired", fields: [pairedSubmissionId], references: [id], onDelete: SetNull)
  similarityScore       Float    @default(0) // 0-100 percentage
  overlappingSegments   String?  // JSON array: [{start: int, end: int, text: string}]
  checkMethod          String   @default("word_overlap") // word_overlap (honest label: not semantic)
  createdAt            DateTime @default(now())
  reviewedBy           String?
  reviewedAt           DateTime?
  
  @@unique([submissionId, pairedSubmissionId])
  @@index([assessmentId])
  @@index([submissionId])
}

