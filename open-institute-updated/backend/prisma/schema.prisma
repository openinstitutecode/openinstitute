// Measur Business College
// Core relational schema. Extend per-module as those modules are built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

// Moodle integration — which engine delivers a given Course.
// CUSTOM is the default so every existing course is unaffected.
// Named LmsEngine (not "delivery mode") to avoid colliding in meaning
// with Programme.deliveryMode, which is an unrelated online/blended/
// in-person classification.
enum LmsEngine {
  CUSTOM
  MOODLE
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum Role {
  SUPER_ADMIN
  BOARD_MEMBER
  PRINCIPAL
  DEPUTY_PRINCIPAL
  REGISTRAR
  FINANCE_OFFICER
  ACCOUNTANT
  HR_OFFICER
  QA_OFFICER
  ICT_ADMIN
  LIBRARIAN
  ADMISSIONS_OFFICER
  EXAMINATION_OFFICER
  DEPARTMENT_HEAD
  PROGRAMME_COORDINATOR
  TRAINER
  COUNSELLOR
  CAREER_OFFICER
  ATTACHMENT_OFFICER
  STUDENT
  APPLICANT
  ALUMNUS
  EXTERNAL_EXAMINER
  EMPLOYER
  AUDITOR
  REGULATORY_INSPECTOR
}

model User {
  id           String    @id @default(cuid())
  accessibilityProfile AccessibilityProfile? // LMS039 (back-relation required by Prisma)
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  mfaEnabled   Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Moodle integration (additive) — null until this user's first
  // interaction with a MOODLE-mode course triggers lazy account creation
  moodleUserId Int?      @unique

  student  Student?
  trainer  Trainer?
  staff    StaffProfile?
  employer EmployerProfile?

  auditLogs   AuditLog[]
  passwordResetTokens PasswordResetToken[] // KFX-004
  documents   Document[]
  aiSessions  AiConversation[]
  notifications Notification[]
  ticketsRaised HelpdeskTicket[] @relation("TicketRaisedBy")
  notificationPreference NotificationPreference? // Batch 69
  dataRequests DataRequest[] // Batch 70
  
  // Batch 43 relations
  tutorSessions     TutorSession[] @relation("TutorSessions")
  simulationSessions SimulationSession[] @relation("SimulationSessionStudent")
  simulationSessionsScored SimulationSession[] @relation("SimulationSessionScorer")
  liveClassesHosted LiveClassSession[] @relation("LiveClassHost")
  accessibilityPrefs UserAccessibilityPreferences?
  creditTransfers   CreditTransferRequest[] @relation("CreditTransfers")
  creditTransferReviews CreditTransferRequest[] @relation("CreditTransferReviews")
  accreditationReviews AccreditationReview[] @relation("AccreditationReviews")

  // Batch 44 relations (added Batch 45 — required by Prisma but missing
  // from the schema Batch 44 shipped; see docs/progress-batch45.md)
  semestersCreated      SemesterConfig[]        @relation("SemesterCreated")
  learningAdaptations   LearningAdaptation[]    @relation("LearningAdaptations")
  resultsExaminer1For   ResultsApprovalChain[]  @relation("ResultsExaminer1")
  resultsExaminer2For   ResultsApprovalChain[]  @relation("ResultsExaminer2")
  resultsQaOfficerFor   ResultsApprovalChain[]  @relation("ResultsQaOfficer")
  aiFeedbackReviewed    AiFeedbackSession[]     @relation("AiFeedbackReview")
  dataImportSessions    DataImportSession[]     @relation("DataImports")

  // Batch 45
  knowledgeBaseAuthored  KnowledgeBaseEntry[] @relation("KnowledgeBaseAuthored")
  knowledgeBaseApproved  KnowledgeBaseEntry[] @relation("KnowledgeBaseApprovals")

  // Batch 53 — RG029/RG030/RG036
  examBoardRatificationsDone     ExamBoardRatification[]     @relation("ExamBoardRatifiedBy")
  academicBoardRatificationsDone AcademicBoardRatification[] @relation("AcademicBoardRatifiedBy")
  regulatoryReportsGenerated     RegulatoryReportBatch[]     @relation("RegulatoryReportsGenerated")

  // Batch 64 — AI033 (AI viva human-confirmed scoring, same principle as
  // SimulationSession.scoredBy)
  aiVivaSessionsScored AiVivaSession[] @relation("AiVivaSessionScorer")
}

model StaffProfile {
  id             String   @id @default(cuid())
  staffNumber    String?  @unique
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  fullName       String
  department     String?
  title          String?
  photoUrl       String?
  nationalIdNo   String?  @unique
  hireDate       DateTime?
  contractType   String?
  createdAt      DateTime @default(now())
}

// ---------------------------------------------------------------------------
// APPLICANTS & ADMISSIONS
// ---------------------------------------------------------------------------

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ADMITTED
  REJECTED
  WAITLISTED
  REGISTERED
}

model Application {
  id            String            @id @default(cuid())
  refNumber     String            @unique
  fullName      String
  email         String
  temporaryPasswordHash String?
  phone         String
  programmeId   String
  programme     Programme         @relation(fields: [programmeId], references: [id])
  studyMode     String
  kcseIndex     String?
  kcseGrade     String?
  priorLearningClaim Boolean      @default(false)
  status        ApplicationStatus @default(SUBMITTED)
  documents     Document[]
  portraitPhotoUrl String?
  student       Student?
  reviewedById  String?
  decisionNote  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// STUDENTS
// ---------------------------------------------------------------------------

enum AcademicStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
  EXCLUDED
}

model Student {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  studentNumber   String         @unique
  admissionNumber String         @unique
  cardId          String         @unique @default(cuid())
  applicationId   String?        @unique
  application     Application?   @relation(fields: [applicationId], references: [id])
  fullName        String
  programmeId     String
  programme       Programme      @relation(fields: [programmeId], references: [id])
  intake          String
  studyMode       String
  academicStatus  AcademicStatus @default(ACTIVE)
  emergencyContactName  String?
  emergencyContactPhone String?
  // EX014/Batch 64 — a student-supplied photo (base64 data URL, same
  // client-side-encoded pattern AI009's PDF upload already uses — this
  // backend has no multipart/binary storage). Used only for admit-card
  // printing so an invigilator can check a face against a card by eye;
  // never used for any automated biometric match, which stays out of
  // scope for this platform (see EX014's note in feature-audit-400.md).
  photoDataUrl    String?        @db.Text
  createdAt       DateTime       @default(now())

  enrollments     Enrollment[]
  feeInvoices     Invoice[]
  attachments     AttachmentPlacement[]
  transcripts     Transcript[]
  certificates    Certificate[]
  helpdeskTickets HelpdeskTicket[]
  integrityCases  IntegrityCase[]
  clubMemberships ClubMembership[]
  counsellingRequests CounsellingRequest[]
  accommodationRequests AccommodationRequest[]
  competencyRecords CompetencyRecord[]
  internshipApplications InternshipApplication[]
  appeals         Appeal[]
  attendanceRecords AttendanceRecord[]
  scholarships    Scholarship[]
  badges          StudentBadge[]
  interventionNotes InterventionNote[]
  academicRecordChanges AcademicRecordChange[]
  microcredentials StudentMicrocredential[]
  evidenceSubmissions CompetencyEvidence[]
  portfolioItems  PortfolioItem[]
  generatedLetters GeneratedLetter[]
  financialHolds  FinancialHold[]
  graduationClearances GraduationClearance[]
  courseCertificates CourseCertificate[]

  // SP017 — per-lesson completion tracking
  lessonProgress  LessonProgress[]

  // Batch 53 — RG030
  academicBoardRatifications AcademicBoardRatification[]

  // Batch 58 — LMS022, LMS029
  scormAttempts   ScormAttempt[]
  lessonTimeLogs  LessonTimeLog[]

  // Batch 64 — AI033 (AI viva) and EX014 (admit cards)
  aiVivaSessions  AiVivaSession[]
  examAdmitCards  ExamAdmitCard[]

  // Batch 65 — VBI001/018: Virtual Business Lab integration (additive)
  labMapping      IntegrationStudentMapping?
  labResults      VirtualLabAssessmentResult[]
  labActivities   VirtualLabActivity[] // Batch 66 — VBI036
}

// ---------------------------------------------------------------------------
// PROGRAMMES, UNITS, CURRICULUM
// ---------------------------------------------------------------------------

model Programme {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  qualificationLevel String  // e.g. "TVET Level 5 Certificate"
  durationSemesters Int
  deliveryMode      String
  requiresAttachment Boolean @default(false)
  approvalStatus    String   @default("pending") // pending | accredited | withdrawn
  version           Int      @default(1)
  // Batch 66 — the programme's official KUCCPS code, once KUCCPS assigns one. Used by the intake
  // export instead of the internal slug (see routes/kuccps.ts). Null = not assigned yet.
  kuccpsCode        String?
  createdAt         DateTime @default(now())

  units Unit[]
  applications Application[]
  students     Student[]
  competencies Competency[]
  rplApplications RplApplication[]
  feeStructureItems FeeStructureItem[]
  awardingBodyId String?
  awardingBody   AwardingBody? @relation(fields: [awardingBodyId], references: [id])
  expenses       Expense[]
  programmeReviews ProgrammeReview[]
  progressionRule ProgressionRule?
  examBlueprints  ExamBlueprint[]
  semesterConfigs SemesterConfig[] @relation("SemesterConfigs") // Batch 44: semester CRUD
  
  // Batch 43
  accreditationReviews AccreditationReview[] @relation("AccreditationReviews")

  // LMS021
  learningPaths LearningPath[]
}

// RG015 — progression rules: the pass-mark / standing thresholds a
// registrar can actually configure per programme, instead of a single
// hardcoded 60%/50% split baked into the standing computation. A
// programme with no row here still gets a sensible default (see
// registry.ts), so this is additive, not a breaking requirement.
model ProgressionRule {
  id                       String    @id @default(cuid())
  programmeId              String    @unique
  programme                Programme @relation(fields: [programmeId], references: [id])
  goodStandingMinAverage   Float     @default(60)
  warningMinAverage        Float     @default(50)
  maxFailedUnitsForGood    Int       @default(0)
  maxFailedUnitsForWarning Int       @default(1)
  updatedAt                DateTime  @updatedAt
  updatedById              String?
}

// RG017 — graduation clearance: computeEligibility() in graduation.ts is
// deliberately always live (so it can never drift from the real data),
// but a registrar formally *issuing* clearance is a distinct, real event
// that should leave its own permanent record — separate from re-running
// the audit again next week. A clearance is only ever created for a
// student who was actually eligible/conditionally-eligible at that
// moment; it is never edited afterward, only superseded by a later one.
model GraduationClearance {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  issuedAt        DateTime @default(now())
  issuedById      String
  eligibilityTier String   // eligible | conditionally_eligible
  snapshot        Json     // the computeEligibility() result at the moment of issuance
}

model Unit {
  id             String   @id @default(cuid())
  programmeId    String
  programme      Programme @relation(fields: [programmeId], references: [id])
  code           String
  title          String
  semester       Int
  creditHours    Int      @default(3)
  learningOutcomes String[] // legacy text array, kept for compatibility

  // LMS020 — prerequisite rules: unit IDs (within the same programme) that
  // must already be completed (Enrollment.status = "completed") before a
  // student can register for this unit. Empty means no prerequisite.
  // Enforced server-side in POST /me/register-unit and the registrar's
  // administrative POST /registry/course-registration — not just a UI hint.
  prerequisiteUnitIds String[] @default([])

  courses                Course[]
  enrollments            Enrollment[]
  questions              Question[]
  notebookEntries        NotebookEntry[]
  formalLearningOutcomes LearningOutcome[] // EX004: formal outcome models
  
  // Batch 43
  creditTransferRequests CreditTransferRequest[]

  // Batch 44 (added Batch 45 — see docs/progress-batch45.md)
  learningAdaptations    LearningAdaptation[] @relation("UnitLearningAdaptations")

  // Batch 45
  knowledgeBaseEntries   KnowledgeBaseEntry[]

  // Batch 63 (AI008–012)
  knowledgeSources       KnowledgeSource[]

  // TP009 — competency mapping: which competencies this unit's curriculum builds
  unitCompetencies       UnitCompetency[]

  // LMS021
  learningPathSteps LearningPathStep[]

  // Batch 65 — VBI003: Virtual Business Lab integration (additive). Default
  // keeps every existing unit exactly as it behaves today — a unit only
  // gains a Lab presence once an admin sets vblEnabled and a course mapping.
  vblEnabled     Boolean   @default(false)
  vblSyncedAt    DateTime?
  labMapping     IntegrationCourseMapping?
  labResults     VirtualLabAssessmentResult[]
  labActivities  VirtualLabActivity[] // Batch 66 — VBI036
  labGradebookMapping     IntegrationGradebookMapping?
  labCompetencyMappings   IntegrationCompetencyMapping[]

  @@unique([programmeId, code])
}

model Course {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  trainerId   String?
  trainer     Trainer? @relation(fields: [trainerId], references: [id])
  title       String
  description String?
  publishedAt DateTime?

  // Moodle integration (additive — default keeps every existing course
  // exactly as it behaves today; nothing here changes existing rows)
  lmsEngine      LmsEngine @default(CUSTOM)
  moodleCourseId Int?      // Moodle's course id, set only when lmsEngine = MOODLE
  moodleSyncedAt DateTime?    // last successful sync timestamp, for diagnostics

  modules              CourseModule[]
  assignments          Assignment[]
  assessments          Assessment[]
  attendanceRecords    AttendanceRecord[]
  timetableEntries     TimetableEntry[]
  forums               Forum[]
  feedback             CourseFeedback[]
  studyGroups          StudyGroup[]
  certificates         CourseCertificate[]
  announcements        CourseAnnouncement[]
  catalogueEntry       CourseCatalogueEntry?
  deliveryPlan         CourseDeliveryPlan?

  // TP026 — live teaching (BigBlueButton-backed sessions for CUSTOM-engine courses)
  liveClasses          LiveClassSession[]

  // Batch 53 — RG029
  examBoardRatifications ExamBoardRatification[]

  // QA014 — course approval
  approvals CourseApproval[]

  // LMS019 — completion rules
  completionRule CourseCompletionRule?
}

model CourseModule {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int
  lessons  Lesson[]
}

model Lesson {
  id             String   @id @default(cuid())
  moduleId       String
  module         CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  contentType    String   // video | reading | interactive | scorm
  contentUrl     String?
  contentBody    String?
  durationMins   Int?
  outcomesCovered String[] @default([]) // subset of the unit's learningOutcomes this lesson addresses

  // TP006 — visual lesson builder. `blocks` is the ordered, typed block list
  // the builder edits (heading/text/image/video/audio/file/callout/code/
  // link/divider — see lib/lesson-blocks.ts for the exact shape and the
  // validation). `contentBody` is still always populated: it's derived from
  // the blocks as markdown on every save, so anything that reads contentBody
  // (AI tutor grounding, exports, older screens) keeps working unchanged.
  blocks         Json?
  // TP007 — a draft lesson is visible to its trainer only. Defaults to true
  // so every lesson that existed before this field keeps being visible.
  isPublished    Boolean  @default(true)
  // TP007 — the lesson's primary media (uploaded video/audio/document),
  // separate from external `contentUrl` links.
  mediaAssetId   String?
  mediaAsset     MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  reviewDueDate  DateTime?
  lastReviewedAt DateTime?

  // LMS037 (Batch 45) — content approval: a substantive edit (contentBody
  // or contentUrl) puts the lesson in PENDING_REVIEW while the previously
  // approved version stays live and visible to students (see LessonVersion);
  // a QA officer or programme coordinator then approves or rejects it.
  approvalStatus String   @default("approved") // approved | pending_review | rejected
  approvedById   String?
  approvedAt     DateTime?

  // LMS007 — content library: free-text keywords so the cross-course
  // library search (GET /content/library) can find a lesson by topic
  // rather than only by browsing its course.
  tags           String[] @default([])
  // LMS024 — offline content: the trainer marks a lesson as safe to cache
  // for offline reading (e.g. it has no live/interactive dependency). The
  // frontend service worker only pre-caches lessons with this set.
  offlineAvailable Boolean @default(false)

  // Batch 77 — LMS content extras
  publishAt      DateTime?                        // CNT030 scheduled publishing (flips isPublished when due)
  category       String?                          // CNT054
  lastNotifiedAt DateTime?                        // CNT044

  versions LessonVersion[]
  // SP017 — one row per student who has marked this lesson complete
  progress LessonProgress[]
  // LMS022 — set when contentType = "scorm"
  scormPackage ScormPackage?
  // LMS029 — per-student time-on-task samples for this lesson
  timeLogs LessonTimeLog[]

  @@index([approvalStatus])
  @@index([moduleId])
}

// TP007 — an uploaded file (video, audio, image, document) stored on the
// backend's upload volume. Bytes live on disk under UPLOAD_DIR/<storageKey>;
// this row is the metadata + ownership record. Served only through signed,
// expiring URLs (see routes/media.ts) — never a public static directory.
model MediaAsset {
  id           String   @id @default(cuid())
  ownerUserId  String
  courseId     String?
  originalName String
  mimeType     String
  kind         String   // video | audio | image | document | archive
  sizeBytes    Int
  storageKey   String   @unique
  sha256       String?
  createdAt    DateTime @default(now())

  lessons Lesson[]

  @@index([ownerUserId])
  @@index([courseId])
}

// SP017 — Learning progress: real per-lesson completion, rolled up into
// per-module and per-course percentages. Previously the "Course content"
// screen had no notion of completion at all — every module always looked
// 0% regardless of what the student had actually been through.
model LessonProgress {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([lessonId])
}

// TP005 — content versioning at the actual content level (Lesson), not
// just the programme-level curriculum version bump that already existed.
// Every edit to contentBody/contentUrl is snapshotted here before the
// live Lesson row changes, so the real prior wording stays inspectable.
model LessonVersion {
  id            String   @id @default(cuid())
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  contentBody   String?
  contentUrl    String?
  // TP006/TP007 — blocks and primary media are part of a lesson's content
  // now, so a snapshot must carry them or "restore" would silently lose them.
  blocks        Json?
  mediaAssetId  String?
  // Was the content in this snapshot approved (not a still-pending edit)?
  // Rejecting an edit, and what students see while an edit is pending,
  // both need "the last APPROVED content", not just "the previous edit".
  wasApproved   Boolean  @default(true)
  editedById    String
  editedAt      DateTime @default(now())

  @@index([lessonId])
}

// LMS036 — Course-level certificates: distinct from institution-wide
// qualification certificates (which already exist); issued when a student
// completes a course with a passing grade
model CourseCertificate {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade         String?  // the course grade
  certificateCode String?
  issuedAt      DateTime @default(now())
  revoked       Boolean  @default(false)
  revokedAt     DateTime?
  
  @@unique([courseId, studentId])
}

// LMS015 — Course-level announcements: scoped to specific courses,
// distinct from institution-wide announcements (Notification)
model CourseAnnouncement {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainerId     String
  trainer       Trainer  @relation(fields: [trainerId], references: [id])
  title         String
  content       String
  importance    String   @default("normal") // low | normal | high | urgent
  pinnedUntil   DateTime? // Batch 45 — auto-unpin after this date
  scheduledAt   DateTime?
  sentAt        DateTime?
  status        String   @default("SENT") // SENT | SCHEDULED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId])
  @@index([pinnedUntil])
  @@index([status, scheduledAt])
}

// LMS001 — Course catalogue enhancement: formal visibility/listing metadata
model CourseCatalogueEntry {
  id            String   @id @default(cuid())
  courseId      String   @unique
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isVisible     Boolean  @default(true) // can students browse it?
  shortCode     String?  // e.g., CS101
  credits       Int?
  level         String?  // foundation | intermediate | advanced
  prerequisites String[] @default([]) // course IDs
  keywords      String[] @default([])
  catalogueUpdatedAt DateTime @default(now())
}

// LMS032 — peer learning: real student-formed study groups tied to a
// course, distinct from LMS033's peer ASSESSMENT (PeerReview, already
// built) — this is collaborative study, not grading.
model StudyGroup {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  name      String
  createdById String
  createdAt DateTime @default(now())

  members StudyGroupMembership[]
  posts   StudyGroupPost[]
}

model StudyGroupMembership {
  id          String     @id @default(cuid())
  groupId     String
  group       StudyGroup @relation(fields: [groupId], references: [id])
  userId      String
  joinedAt    DateTime   @default(now())

  @@unique([groupId, userId])
}

model StudyGroupPost {
  id        String     @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id])
  authorId  String
  body      String
  postedAt  DateTime   @default(now())
}

// AD030 — security centre: a real record of every failed login, not a
// cosmetic "security score." Written directly in the login handler.
model FailedLoginAttempt {
  id          String   @id @default(cuid())
  email       String
  ipAddress   String?
  reason      String   // no_such_user | inactive_user | wrong_password | locked
  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt]) // KPERF-003 — lockout check runs on every login
  @@index([ipAddress, attemptedAt])
}

// AD032 — API management: real issued keys for external integrations,
// with real usage tracking, not a static claim of "API access available."
model ApiKey {
  id          String    @id @default(cuid())
  label       String
  keyHash     String    @unique
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?
}

// AD035/036 — report builder + "scheduled" reports. Honest about AD036:
// this sandbox has no cron/scheduler (same limitation as FN020's
// reminders), so a subscription here only records the intent (who wants
// what, how often) — it is never claimed to fire automatically. An
// admin still has to press "run now," same pattern as the reminders tool.
model SavedReport {
  id          String   @id @default(cuid())
  name        String
  entity      String   // students | finance | compliance | research
  filters     Json?
  createdById String
  createdAt   DateTime @default(now())

  subscriptions ScheduledReportSubscription[]
}

model ScheduledReportSubscription {
  id            String      @id @default(cuid())
  reportId      String
  report        SavedReport @relation(fields: [reportId], references: [id])
  recipientId   String
  frequency     String      // daily | weekly | monthly — recorded intent only, nothing fires this automatically
  createdAt     DateTime    @default(now())
  lastRunAt     DateTime?
}

// LB032 — startup incubation: a real cohort/stage record tied to a
// ResearchProject of type "startup".
model IncubationRecord {
  id          String   @id @default(cuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id])
  cohort      String?
  stage       String   @default("idea") // idea | mvp | growth
  joinedAt    DateTime @default(now())
}

// LB033 — mentorship: real assignments with a start/status, distinct
// from IncubationRecord's single mentor-stage snapshot — a project can
// have a history of mentors over time.
model Mentorship {
  id          String    @id @default(cuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id])
  mentorUserId String
  focusArea   String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  status      String    @default("active") // active | completed
}

// ---------------------------------------------------------------------------
// TRAINERS
// ---------------------------------------------------------------------------

model Trainer {
  id                 String   @id @default(cuid())
  staffNumber        String?  @unique
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  fullName           String
  photoUrl           String?
  tvetaLicenceNumber String?
  licenceExpiry      DateTime?
  qualifications     String[]
  department         String?

  // TP039 — TVETA credential profile. The licence number/expiry fields
  // above already existed and were shown read-only in AdminTrainers; there
  // was no way to actually record that someone checked the licence against
  // TVETA and confirmed it real, nor to attach the scanned certificate
  // itself. Deliberately mirrors the Lesson content-approval pattern
  // (approvedById/approvedAt) rather than inventing a new shape.
  licenceVerified     Boolean   @default(false)
  licenceVerifiedAt   DateTime?
  licenceVerifiedById String?
  licenceDocumentUrl  String?

  // QA011 — trainer compliance beyond the licence: the other three things
  // an inspection actually checks per trainer, recorded the same
  // verified-by/verified-at way as the licence fields above rather than
  // a bare boolean nobody can trace back to who confirmed it.
  codeOfConductSignedAt    DateTime?
  inductionCompletedAt     DateTime?
  backgroundCheckClearedAt DateTime?
  backgroundCheckClearedById String?

  courses Course[]
  cpdActivities CpdActivity[]
  interventionNotes InterventionNote[]
  researchSupervised ResearchProject[]
  courseAnnouncements CourseAnnouncement[]

  // Batch 65 — VBI002: Virtual Business Lab integration (additive)
  labMapping IntegrationStaffMapping?
}

// ---------------------------------------------------------------------------
// ENROLLMENT, ASSESSMENT, GRADES
// ---------------------------------------------------------------------------

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  semester   String
  status     String   @default("in_progress") // in_progress | completed | failed | withdrawn
  finalGrade String?
  createdAt  DateTime @default(now())

  // Deprecated: Moodle does not expose an enrolment id through the
  // enrolment API currently used by this integration. Kept for migration
  // compatibility; new synchronizations do not populate this field.
  moodleEnrolmentId Int?

  // Batch 65 — VBI004: set once this enrollment has been synchronized to
  // the Virtual Business Lab (only attempted when Unit.vblEnabled is true).
  vblSyncedAt DateTime?

  @@unique([studentId, unitId, semester])
}

model Question {
  id                String   @id @default(cuid())
  unitId            String
  unit              Unit     @relation(fields: [unitId], references: [id])
  type              String   // mcq | short_answer | essay
  prompt            String
  options           String[] // for mcq
  correctAnswer     String?
  marks             Int      @default(1)
  difficulty        String   @default("medium") // easy | medium | hard
  topic             String?
  competencyId      String?
  competency        Competency? @relation(fields: [competencyId], references: [id])
  learningOutcomeId String?
  learningOutcome   LearningOutcome? @relation(fields: [learningOutcomeId], references: [id], onDelete: SetNull)
  approvedById      String?
  // TP011 — shown to the student after a quiz attempt when the quiz allows
  // feedback (why the right answer is right).
  explanation       String?
  createdById       String?
  createdAt         DateTime @default(now())
  responses         QuestionResponse[]
  assessmentLinks   AssessmentQuestion[]

  // Batch 76 — quiz engine v2 (LMS-QZ-006…080). `type` now also accepts
  // mcq_multi | fill_blank | numerical | matching | ordering | case_study |
  // scenario | practical (see lib/quiz-engine.ts). `config` holds the
  // type-specific answer key and marking policy; null on every older row, which
  // keeps scoring byte-identical for them.
  config            Json?
  mediaUrl          String?   // QZ016-018 image / audio / video attached to the question
  mediaKind         String?   // image | audio | video
  tags              String[]  @default([])
  version           Int       @default(1)
  archivedAt        DateTime? // soft delete: archived questions leave the bank but stay on old quizzes
  updatedAt         DateTime  @default(now())
  versions          QuestionVersion[]
  reports           QuestionReport[]
}

// QZ040 — every edit snapshots the question first, so earlier wording and
// keys stay inspectable and restorable.
model QuestionVersion {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json
  editedById String
  editedAt   DateTime @default(now())

  @@unique([questionId, version])
  @@index([questionId])
}

// QZ078 — a student (or trainer) flags a question as wrong/unclear/ambiguous.
model QuestionReport {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assessmentId   String?
  reporterUserId String
  category       String   @default("error") // error | unclear | ambiguous | typo | other
  message        String
  status         String   @default("open") // open | resolved | dismissed
  resolution     String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([questionId])
  @@index([assessmentId])
  @@index([status])
}

// QZ060 — in-progress answers, saved as the student works, so a refresh,
// dropped connection or expired tab never loses them.
model QuizAttemptDraft {
  id            String   @id @default(cuid())
  assessmentId  String
  studentUserId String
  answers       Json     // { [questionId]: answerString }
  flagged       String[] @default([]) // QZ058 questions the student marked for review
  currentIndex  Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([assessmentId, studentUserId])
}

// QZ080 — per-student approved extension on one quiz (extra attempts and/or a
// later closing time). Separate from ExamAccommodation (extra minutes), which
// continues to work as before.
model QuizExtension {
  id              String   @id @default(cuid())
  assessmentId    String
  studentUserId   String
  extraAttempts   Int      @default(0)
  extendedCloseAt DateTime?
  reason          String
  grantedById     String
  createdAt       DateTime @default(now())
  revokedAt       DateTime?

  @@unique([assessmentId, studentUserId])
  @@index([assessmentId])
}

enum AssessmentType {
  FORMATIVE_QUIZ
  ASSIGNMENT
  CAT
  FINAL_EXAM
  PRACTICAL
}

model Assessment {
  id           String         @id @default(cuid())
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id])
  blueprintId  String?
  blueprint    ExamBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  title        String
  type         AssessmentType
  builderType  String         @default("GENERIC") // GENERIC | QUIZ | EXAMINATION | ASSIGNMENT (Batch 44)
  totalMarks   Int
  requiresHumanModeration Boolean @default(true)
  scheduledAt  DateTime?
  durationMinutes Int?
  maxAttempts  Int      @default(1)

  // TP011 — quiz builder settings. All defaults preserve the behaviour every
  // pre-existing assessment already had (visible, unshuffled, no pass mark).
  instructions            String?
  isDraft                 Boolean  @default(false)  // builder-created quizzes start as drafts
  shuffleQuestions        Boolean  @default(false)
  passMarkPercent         Int?
  showFeedbackAfterSubmit Boolean  @default(true)
  questionLinks           AssessmentQuestion[]

  // Batch 76 — quiz engine v2. All defaults reproduce earlier behaviour.
  opensAt            DateTime?            // QZ047 (falls back to scheduledAt for non-formative)
  closesAt           DateTime?            // QZ048
  gradingMethod      String   @default("HIGHEST") // QZ051-053 HIGHEST | AVERAGE | LATEST | FIRST
  questionsPerPage   Int?                 // QZ056/057 (1 = one at a time)
  navigationMode     String   @default("FREE")    // QZ058 FREE | FORWARD_ONLY
  markingMode        String   @default("IMMEDIATE") // QZ063/064 IMMEDIATE | DEFERRED
  resultVisibility   String   @default("IMMEDIATE") // QZ071 IMMEDIATE | AFTER_CLOSE | ON_RELEASE | HIDDEN
  answerKeyReleaseAt DateTime?            // QZ070
  allowedIntakes     String[] @default([]) // QZ079 empty = everyone enrolled
  randomRules        Json?                // QZ035 [{count, topic?, difficulty?}]
  shuffleOptions     Boolean?             // QZ036 null = follow shuffleQuestions (old behaviour)
  retakeCooldownMins Int      @default(0) // QZ050 minimum wait between attempts
  resultsPublished Boolean @default(false)
  resultsPublishedAt DateTime?
  resultsSubmittedForApprovalAt DateTime?
  resultsSubmittedById String?
  resultsApprovedAt DateTime?
  resultsApprovedById String?
  resultsApprovalNote String?
  submissions  Submission[]
  rubric       Rubric?
  incidents    ExamIncident[]
  sessions     ExamSession[]
  oralSessions OralAssessmentSession[]
  externalModerationReviews ExternalModerationReview[]
  resultsApprovals ResultsApprovalChain[] @relation("ResultsApprovals")  // Batch 44: multi-stage approval
  
  // Batch 43
  similarityChecks SimilarityCheck[]
  // Batch 56
  accommodations ExamAccommodation[]
  practicalChecklist PracticalChecklist?

  // Batch 64 — EX014 (candidate admit cards) and AI033 (AI viva, when tied
  // to a specific oral assessment rather than free practice)
  admitCards     ExamAdmitCard[]
  aiVivaSessions AiVivaSession[]

  // Batch 65 — VBI025: reverse side of IntegrationGradebookMapping.assessmentId
  vblGradebookMappings IntegrationGradebookMapping[]
}

// TP011 — the explicit, ordered question list of one quiz. Before this, a
// sitting's question pool was resolved dynamically as "every approved
// question in the unit", so a trainer could not choose which questions a
// specific quiz contained, nor give one question different marks in
// different quizzes. When an Assessment has no rows here it still falls back
// to that unit-wide pool, so existing exams behave exactly as before.
model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id])
  order        Int
  marks        Int?       // overrides Question.marks for this quiz only

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// EX035 — oral assessment / viva: a human-conducted session recorded for
// real, not an AI-graded interaction (that would be AI033, which needs
// real speech infrastructure this system doesn't have and correctly
// remains unbuilt).
model OralAssessmentSession {
  id            String   @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  studentUserId String
  examinerId    String
  score         Float?
  notes         String?
  recordedAt    DateTime @default(now())
}

// TP030 — student messaging: real, private, one-to-one messages between a
// trainer and a student. Deliberately separate from the institution-wide
// Notification broadcast (AD013) and from public DiscussionForum posts —
// this is direct correspondence, readable only by its two participants.
model DirectMessage {
  id           String   @id @default(cuid())
  senderId     String
  recipientId  String
  body         String
  sentAt       DateTime @default(now())
  readAt       DateTime?
}

// TP028 — virtual office hours: real published availability a student can
// see, not a static claim of "available Tuesdays."
model OfficeHourSlot {
  id         String   @id @default(cuid())
  trainerId  String
  dayOfWeek  Int      // 0=Sunday .. 6=Saturday
  startTime  String   // "HH:MM"
  endTime    String
  link       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  title       String
  instructions String
  dueAt       DateTime
  totalMarks  Int
  submissions Submission[]

  // Batch 77 — assignments v2 (LMS-ASG-001…040). Every default reproduces the
  // behaviour assignments already had (published, individual, text+files, one
  // submission, no late window, grades visible as soon as they are entered).
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
  status             String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED   ASG005/040
  releaseAt          DateTime?                       // ASG005 scheduled release
  archivedAt         DateTime?                       // ASG040
  category           String   @default("ASSIGNMENT") // ASSIGNMENT | PRACTICAL | PROJECT | CAT  (GRD005)
  weightPercent      Float    @default(0)            // GRD008/009 share of the course grade (0 = unweighted)
  mode               String   @default("INDIVIDUAL") // INDIVIDUAL | GROUP     ASG006/007
  maxGroupSize       Int      @default(5)
  allowText          Boolean  @default(true)         // ASG008
  allowFiles         Boolean  @default(true)         // ASG009
  maxFiles           Int      @default(5)            // ASG010
  maxFileMb          Int      @default(20)
  allowedKinds       String[] @default([])           // ASG011-016: pdf word excel powerpoint audio video image archive text; empty = any allowed type
  requireEvidence    Boolean  @default(false)        // ASG016 practical evidence must be attached
  lateMode           String   @default("NONE")       // NONE | PENALTY | ACCEPT       ASG019
  cutoffAt           DateTime?                       // hard stop for late work
  latePenaltyPctPerDay Float  @default(10)
  latePenaltyMaxPct  Float    @default(50)
  maxResubmissions   Int      @default(0)            // ASG023
  rubricCriteria     Json?                           // ASG028 [{ name, description, maxMarks }]
  competencyBased    Boolean  @default(false)        // ASG029 COMPETENT / NOT_YET_COMPETENT
  competencyId       String?
  holdGrades         Boolean  @default(false)        // ASG037 true = grades hidden until released
  gradesReleasedAt   DateTime?
  requireModeration  Boolean  @default(false)        // ASG035
  moderationSamplePct Int     @default(0)
  checkSimilarity    Boolean  @default(false)        // ASG039
  confirmationNote   String?                         // ASG018 text added to the receipt
  reminderSentAt     DateTime?

  groups      AssignmentGroup[]
  extensions  AssignmentExtension[]

  @@index([courseId])
  @@index([status])
}

// ASG006/007 — a working group for a GROUP assignment. One group submission
// is made per group; every member sees it and shares its grade.
model AssignmentGroup {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  createdById  String
  createdAt    DateTime @default(now())
  members      AssignmentGroupMember[]

  @@index([assignmentId])
}

model AssignmentGroupMember {
  id            String   @id @default(cuid())
  groupId       String
  group         AssignmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignmentId  String
  studentUserId String
  joinedAt      DateTime @default(now())

  @@unique([assignmentId, studentUserId])
  @@index([groupId])
}

// ASG021/022 — a student asks for more time; the course trainer decides.
model AssignmentExtension {
  id            String   @id @default(cuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentUserId String
  requestedDueAt DateTime
  reason        String
  status        String   @default("REQUESTED") // REQUESTED | APPROVED | DENIED
  grantedDueAt  DateTime?
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime @default(now())

  @@unique([assignmentId, studentUserId])
  @@index([assignmentId])
}

// ASG024 — every submit / resubmit keeps its own snapshot, so earlier work is never overwritten.
model SubmissionVersion {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  versionNo    Int
  textAnswer   String?
  fileAssetIds String[] @default([])
  isLate       Boolean  @default(false)
  note         String?
  submittedAt  DateTime @default(now())

  @@unique([submissionId, versionNo])
}

model Submission {
  id            String      @id @default(cuid())
  assessmentId  String?
  assessment    Assessment? @relation(fields: [assessmentId], references: [id])
  assignmentId  String?
  assignment    Assignment? @relation(fields: [assignmentId], references: [id])
  studentUserId String
  fileUrl       String?
  textAnswer    String?
  submittedAt   DateTime    @default(now())
  score         Float?
  gradedById    String?
  gradedAt      DateTime?
  feedback      String?
  criteriaScores Json?      // EX021 — [{ name, maxMarks, score }] when graded against a Rubric
  aiAssisted    Boolean     @default(false)
  integrityFlag Boolean     @default(false)

  // Batch 77 — assignments v2. Defaults keep every existing row valid.
  isDraft        Boolean    @default(false)   // ASG017 saved but not yet handed in
  isLate         Boolean    @default(false)   // ASG020
  lateMinutes    Int?
  latePenaltyPct Float?                       // ASG019 percentage taken off rawScore
  rawScore       Float?                       // score before the late penalty
  fileAssetIds   String[]   @default([])      // ASG009/010 uploaded evidence / files
  groupId        String?                      // ASG007
  versionCount   Int        @default(1)       // ASG023/024
  resubmittedAt  DateTime?                    // ASG036 set when handed in again after grading
  needsRegrade   Boolean    @default(false)
  competencyResult String?                    // ASG029 COMPETENT | NOT_YET_COMPETENT
  annotations    Json?                        // ASG026/034 [{ start, end, quote, comment }]
  feedbackAssetIds String[] @default([])      // ASG032/033/034 audio / video / annotated file feedback
  similarityScore Float?                      // ASG039 highest word-overlap % against classmates
  similarityNote  String?
  versions       SubmissionVersion[]
  peerReviews   PeerReview[]
  questionResponses QuestionResponse[]
  marks         SubmissionMark[]
  amendmentRequests ResultsAmendmentRequest[]
  aiFeedback       AiFeedbackSession[] @relation("AiFeedback")     // Batch 44: AI feedback generation
  
  // Batch 43
  similarityChecks SimilarityCheck[]
  similarityChecksPaired SimilarityCheck[] @relation("SimilarityCheckPaired")
  // Batch 56
  practicalChecklistResult PracticalChecklistResult?

  // Batch 65 — VBI025/034: when this Submission was posted by the Virtual
  // Business Lab integration rather than entered/graded directly, this
  // links back to the approved result that produced it. Unique because one
  // Lab result posts at most one Submission (re-posting on reversal updates
  // this same row rather than creating a second one).
  vblResultId String? @unique
  vblResult   VirtualLabAssessmentResult? @relation(fields: [vblResultId], references: [id])
}

// ---------------------------------------------------------------------------
// CREDENTIALS: TRANSCRIPTS & CERTIFICATES
// ---------------------------------------------------------------------------

model Transcript {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  documentId    String   @unique
  verificationUrl String
  issuedAt      DateTime @default(now())
  signedHash    String
  // Printable-transcript feature (additive, nullable): the exact JSON text that was signed, so an issued transcript can be
  // re-displayed/printed later unaffected by grade edits. Deliberately TEXT, not Json: Postgres jsonb reorders object keys,
  // which would break the HMAC signature check on re-read. Null on transcripts issued before this existed.
  payload       String?
  revoked       Boolean  @default(false)
  revokedReason String?
  revokedAt     DateTime?
}

model Certificate {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  qualification   String
  documentId      String   @unique
  verificationUrl String
  issuedAt        DateTime @default(now())
  signedHash      String
  revoked         Boolean  @default(false)
  revokedReason   String?
  revokedAt       DateTime?
}

// ---------------------------------------------------------------------------
// FINANCE
// ---------------------------------------------------------------------------

model Invoice {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  semester   String
  amountDue  Decimal  @db.Decimal(10, 2)
  amountPaid Decimal  @default(0) @db.Decimal(10, 2)
  dueDate    DateTime
  status     String   @default("unpaid") // unpaid | partial | paid | overdue
  payments   Payment[]
  installmentPlans InstallmentPlan[]
  createdAt  DateTime @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(10, 2)
  method      String   // mpesa | bank | card
  reference   String   @unique
  paidAt      DateTime @default(now())
  receipt     Receipt?
  reversedAt  DateTime?
  reversalReason String?
  refundRequests RefundRequest[]
}

// FN012 — refund management: a request/approval workflow, same discipline
// as results amendments and everything else that touches money or grades
// in this codebase — approval is a distinct action from the request, and
// only approval actually posts the reversing journal entry and reduces
// the invoice balance.
model RefundRequest {
  id            String    @id @default(cuid())
  paymentId     String
  payment       Payment   @relation(fields: [paymentId], references: [id])
  amount        Decimal   @db.Decimal(10, 2)
  reason        String
  requestedById String
  status        String    @default("pending") // pending | approved | rejected
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())
}

// FN014 — installment plans: a real, persisted schedule (not just computed
// on the fly), so it survives even as the invoice balance changes.
model InstallmentPlan {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  createdById String
  createdAt   DateTime @default(now())

  items InstallmentScheduleItem[]
}

model InstallmentScheduleItem {
  id        String   @id @default(cuid())
  planId    String
  plan      InstallmentPlan @relation(fields: [planId], references: [id])
  dueDate   DateTime
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime?
}

// FN025/026 — budgets: a draft->submitted->approved/rejected workflow,
// matching dev rule 21 (human approval for high-impact financial
// decisions) — a budget can never self-approve.
model Budget {
  id             String    @id @default(cuid())
  department     String
  category       String
  fiscalPeriod   String    // e.g. "2026-S1"
  allocatedAmount Decimal  @db.Decimal(12, 2)
  justification  String?
  status         String    @default("draft") // draft | submitted | approved | rejected
  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())
}

// FN032 — inventory: consumable/stock items, distinct from the fixed
// Asset register. quantityOnHand is maintained transactionally from
// InventoryTransaction rows (a real stock ledger), not a bare mutable
// field that could drift from its own history.
model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String
  unit          String   // e.g. "boxes", "reams", "units"
  quantityOnHand Int     @default(0)
  reorderLevel  Int      @default(0)
  location      String?
  createdAt     DateTime @default(now())

  transactions InventoryTransaction[]
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  type        String   // restock | consumption | adjustment
  quantity    Int      // positive for restock, negative for consumption; adjustment can be either
  note        String?
  recordedById String
  recordedAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// INDUSTRIAL ATTACHMENT
// ---------------------------------------------------------------------------

model Employer {
  id        String   @id @default(cuid())
  name      String
  sector    String?
  location  String?
  contactEmail String?
  employerProfile EmployerProfile?
  placements AttachmentPlacement[]
  postings  InternshipPosting[]
}

model EmployerProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  employerId String   @unique
  employer   Employer @relation(fields: [employerId], references: [id])
}

model AttachmentPlacement {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  employerId   String
  employer     Employer @relation(fields: [employerId], references: [id])
  supervisorName String?
  startDate    DateTime
  endDate      DateTime
  status       String   @default("pending") // pending | active | completed | terminated
  logbookEntries LogbookEntry[]
}

model LogbookEntry {
  id           String   @id @default(cuid())
  placementId  String
  placement    AttachmentPlacement @relation(fields: [placementId], references: [id])
  weekNumber   Int
  summary      String
  submittedAt  DateTime @default(now())
  supervisorSignOff Boolean @default(false)
}

// ---------------------------------------------------------------------------
// DIGITAL LIBRARY
// ---------------------------------------------------------------------------

model LibraryResource {
  id          String   @id @default(cuid())
  title       String
  author      String?
  type        String   // ebook | journal | oer | video | case_study | government_doc
  subject     String?
  fileUrl     String?
  externalUrl String?
  licence     String?  // open | licensed | restricted
  // LB004 — real full-text search target. Optional plain-text body (an
  // abstract, an OCR'd extract, or a librarian-pasted excerpt) a librarian
  // adds at catalogue time. When null, this resource is still only
  // findable by title/author/subject — the search code never pretends
  // content exists when this is empty.
  content     String?  @db.Text
  // LB005–010 — free-form, type-scoped fields (e.g. isbn/edition for an
  // ebook, volume/issue/doi for a journal, durationMinutes for a video).
  // Kept as JSON rather than a wide sparse table of nullable columns; the
  // known keys per type are documented and validated in library.ts, not
  // enforced at the DB layer.
  metadata    Json?
  addedAt     DateTime @default(now())

  bookmarks   LibraryBookmark[]
  readingListItems ReadingListItem[]
  accessGrants LibraryAccessGrant[]
  usageEvents  LibraryUsageEvent[]
  annotations  LibraryAnnotation[]
}

// LB012 — real annotation: a page-anchored note a reader writes about a
// resource, private to them. This is not free-hand highlighting/drawing
// over the PDF (this platform doesn't render or manipulate PDF page
// content) — it's a genuine per-page note a student can build a reading
// record from, viewed alongside the inline PDF viewer (LB011).
model LibraryAnnotation {
  id         String   @id @default(cuid())
  resourceId String
  resource   LibraryResource @relation(fields: [resourceId], references: [id])
  userId     String
  page       Int?
  note       String
  createdAt  DateTime @default(now())
}

// LB038 — copyright controls, actually enforced: a "restricted" resource's
// fileUrl is withheld from the catalogue response unless the requesting
// user is library staff or holds an explicit grant recorded here. This
// replaces the old state where a `licence` field existed but nothing in
// the code ever checked it.
model LibraryAccessGrant {
  id          String   @id @default(cuid())
  userId      String
  resourceId  String
  resource    LibraryResource @relation(fields: [resourceId], references: [id])
  grantedById String
  grantedAt   DateTime @default(now())

  @@unique([userId, resourceId])
}

// LB039 — usage analytics: a real event log (view/bookmark/checkout),
// not a derived guess — "most used resources" is a real count over this
// table.
model LibraryUsageEvent {
  id         String   @id @default(cuid())
  resourceId String
  resource   LibraryResource @relation(fields: [resourceId], references: [id])
  userId     String
  action     String   // view | bookmark | checkout
  occurredAt DateTime @default(now())
}

model LibraryBookmark {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  resource   LibraryResource @relation(fields: [resourceId], references: [id])
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
}

model ReadingList {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())

  items     ReadingListItem[]
}

model ReadingListItem {
  id            String   @id @default(cuid())
  readingListId String
  readingList   ReadingList @relation(fields: [readingListId], references: [id])
  resourceId    String
  resource      LibraryResource @relation(fields: [resourceId], references: [id])
  addedAt       DateTime @default(now())
}

