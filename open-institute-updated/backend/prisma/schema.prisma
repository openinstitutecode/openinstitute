// ---------------------------------------------------------------------------
// RESEARCH & INNOVATION
// ---------------------------------------------------------------------------

model ResearchProject {
  id             String   @id @default(cuid())
  title          String
  type           String   // student_research | trainer_research | innovation | startup
  leadUserId     String
  supervisorId   String?  // Trainer.id
  supervisor     Trainer? @relation(fields: [supervisorId], references: [id])
  status         String   @default("proposed") // proposed | approved | in_progress | completed | published
  abstract       String?
  ethicsRequired Boolean  @default(false)
  // Kept in sync with the latest EthicsSubmission's status (true only once
  // one has been decided "approved") rather than toggled directly — see
  // LB027 below.
  ethicsApproved Boolean  @default(false)
  createdAt      DateTime @default(now())

  milestones     ResearchMilestone[]
  publications   Publication[]
  notes          ResearchNote[]
  bibliography   BibliographyEntry[]
  literatureMatrix LiteratureMatrixEntry[]
  conferenceSubmissions ConferenceSubmission[]
  grants         ResearchGrant[]
  intellectualProperty IntellectualProperty[]
  incubationRecords IncubationRecord[]
  mentorships    Mentorship[]
  ethicsSubmissions EthicsSubmission[]
}

// LB027 — real ethics review workflow: a researcher submits a protocol
// (what will be done, the risks and how they're mitigated); a reviewer
// moves it through real committee states and, only on approval, assigns a
// protocol number. This replaces the old single ethicsApproved boolean
// with an actual reviewable submission and a decision history — a project
// can be sent back for revisions and resubmitted, which the old flag
// couldn't represent at all.
model EthicsSubmission {
  id                 String   @id @default(cuid())
  projectId          String
  project            ResearchProject @relation(fields: [projectId], references: [id])
  summary            String   // what will be done, to whom/what, and how
  risksAndMitigation String?
  status             String   @default("submitted") // submitted | under_review | revisions_requested | approved | rejected
  protocolNumber     String?  // assigned by the reviewer only on approval
  submittedAt        DateTime @default(now())
  decidedAt          DateTime?
  decidedById        String?
  decisionNotes      String?
}

model ResearchMilestone {
  id         String   @id @default(cuid())
  projectId  String
  project    ResearchProject @relation(fields: [projectId], references: [id])
  title      String
  dueDate    DateTime?
  status     String   @default("pending") // pending | done
  createdAt  DateTime @default(now())
}

// LB016 — research notebook: notes tied to a specific research project,
// distinct from a student's general knowledge notebook (NotebookEntry).
model ResearchNote {
  id            String   @id @default(cuid())
  projectId     String
  project       ResearchProject @relation(fields: [projectId], references: [id])
  authorUserId  String
  title         String
  content       String
  createdAt     DateTime @default(now())
}

// LB018 — bibliography manager: sources a researcher is tracking for a
// project. Formatting (APA/MLA) reuses the same pure-logic approach as
// LB017 (frontend/src/lib/citations.ts) — no field is ever invented, only
// what's actually entered here gets formatted.
model BibliographyEntry {
  id          String   @id @default(cuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id])
  sourceType  String   // book | journal_article | website | report | other
  title       String
  author      String?
  year        Int?
  publisher   String?
  url         String?
  addedAt     DateTime @default(now())
}

// LB019 — literature matrix: a structured comparison table a researcher
// builds while reviewing sources — real entries they write, not an
// AI-generated summary of content the system doesn't actually have.
model LiteratureMatrixEntry {
  id             String   @id @default(cuid())
  projectId      String
  project        ResearchProject @relation(fields: [projectId], references: [id])
  sourceTitle    String
  author         String?
  year           Int?
  methodology    String?
  keyFindings    String?
  relevanceNote  String?
  addedAt        DateTime @default(now())
}

// LB029 — conference management: real deadlines and submission tracking.
model Conference {
  id                  String   @id @default(cuid())
  name                String
  location            String?
  startDate           DateTime
  endDate             DateTime
  submissionDeadline  DateTime?
  url                 String?
  createdAt           DateTime @default(now())

  submissions ConferenceSubmission[]
}

model ConferenceSubmission {
  id            String    @id @default(cuid())
  conferenceId  String
  conference    Conference @relation(fields: [conferenceId], references: [id])
  projectId     String
  project       ResearchProject @relation(fields: [projectId], references: [id])
  title         String
  status        String    @default("submitted") // submitted | accepted | rejected | presented
  submittedById String
  submittedAt   DateTime  @default(now())
}

// LB030 — research funding: real grant applications and their status,
// never a projected/assumed award.
model ResearchGrant {
  id          String    @id @default(cuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id])
  funder      String
  amount      Decimal   @db.Decimal(12, 2)
  status      String    @default("applied") // applied | awarded | rejected | completed
  appliedAt   DateTime  @default(now())
  decidedAt   DateTime?
}

// LB034 — intellectual property: tracked at whatever stage it's really
// at (idea/filed/granted) — never claimed as "granted" without a real
// filing number recorded.
model IntellectualProperty {
  id            String   @id @default(cuid())
  projectId     String
  project       ResearchProject @relation(fields: [projectId], references: [id])
  type          String   // patent | trademark | copyright | trade_secret
  title         String
  filingStatus  String   @default("idea") // idea | filed | granted
  filingNumber  String?
  filedAt       DateTime?
  createdAt     DateTime @default(now())
}

model Publication {
  id          String   @id @default(cuid())
  projectId   String?
  project     ResearchProject? @relation(fields: [projectId], references: [id])
  title       String
  authors     String[]
  venue       String?  // journal/conference name
  year        Int?
  url         String?
  createdAt   DateTime @default(now())
}



// ---------------------------------------------------------------------------
// EXAMINATION INCIDENTS
// ---------------------------------------------------------------------------

model ExamIncident {
  id           String   @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  studentId    String?
  reportedById String
  description  String
  status       String   @default("open") // open | investigating | resolved
