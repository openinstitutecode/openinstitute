// SP038 — a student-initiated application against a posting, distinct from
// the auto-computed skill match: a match score is a suggestion, this is an
// actual expressed intent to apply. Deciding "accepted" is the one place in
// the whole codebase that creates a real AttachmentPlacement — until this
// model, nothing did (placements could only ever be viewed, never created).
model InternshipApplication {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  postingId   String
  posting     InternshipPosting @relation(fields: [postingId], references: [id])
  coverNote   String?
  status      String   @default("applied") // applied | shortlisted | accepted | rejected
  appliedAt   DateTime @default(now())
  decidedAt   DateTime?
  decidedById String?

  @@unique([studentId, postingId])
}

model PeerReview {
  id           String   @id @default(cuid())
