// LMS021 — Learning paths: a real, ordered, programme-scoped sequence of
// units a coordinator recommends (or requires) students follow, distinct
// from LMS020's hard prerequisite gate — a path can suggest an order
// without blocking registration outside it.
model LearningPath {
  id           String   @id @default(cuid())
  programmeId  String
  programme    Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  isPublished  Boolean  @default(false)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  steps LearningPathStep[]

  @@index([programmeId])
}

model LearningPathStep {
  id           String       @id @default(cuid())
  pathId       String
  path         LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order        Int
  isOptional   Boolean      @default(false)
  note         String?

  @@unique([pathId, unitId])
  @@index([pathId])
